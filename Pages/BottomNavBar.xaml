<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.BottomNavBar">

    <ContentView.Resources>
        <ResourceDictionary>
            <Color x:Key="Navy">#1A2332</Color>
            <Color x:Key="Orange">#FF9900</Color>
            <Color x:Key="NavMuted">#8A9BB0</Color>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border BackgroundColor="{StaticResource Navy}"
            StrokeThickness="0"
            Padding="0,10,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20,20,0,0"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#33000000" Offset="0,-4" Radius="12" Opacity="0.3"/>
        </Border.Shadow>

        <Grid ColumnDefinitions="*,*,*,*,*"
              Padding="8,0,8,20"
              HeightRequest="64">

            <!-- Home -->
            <VerticalStackLayout Grid.Column="0"
                                 Spacing="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 x:Name="HomeTab">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTabTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="HomeIcon" Text="🏠" FontSize="22"
                       HorizontalOptions="Center"/>
                <Label x:Name="HomeLabel" Text="Home" FontSize="10"
                       HorizontalOptions="Center" FontAttributes="Bold"
                       TextColor="{StaticResource Orange}"/>
                <BoxView x:Name="HomeDot"
                         HeightRequest="4" WidthRequest="4"
                         BackgroundColor="{StaticResource Orange}"
                         HorizontalOptions="Center">
                    <BoxView.Clip>
                        <RoundRectangleGeometry Rect="0,0,4,4" CornerRadius="2"/>
                    </BoxView.Clip>
                </BoxView>
            </VerticalStackLayout>

            <!-- Search -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 x:Name="SearchTab">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSearchTabTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="SearchIcon" Text="🔍" FontSize="22"
                       HorizontalOptions="Center" Opacity="0.55"/>
                <Label x:Name="SearchLabel" Text="Search" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource NavMuted}"/>
                <BoxView x:Name="SearchDot"
                         HeightRequest="4" WidthRequest="4"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Center">
                    <BoxView.Clip>
                        <RoundRectangleGeometry Rect="0,0,4,4" CornerRadius="2"/>
                    </BoxView.Clip>
                </BoxView>
            </VerticalStackLayout>

            <!-- Orders (centre, slightly raised) -->
            <Grid Grid.Column="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  Margin="0,-18,0,0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOrdersTabTapped"/>
                </Grid.GestureRecognizers>
                <Border BackgroundColor="{StaticResource Orange}"
                        WidthRequest="52" HeightRequest="52"
                        StrokeThickness="3"
                        Stroke="{StaticResource Navy}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Orange}" Offset="0,2" Radius="8" Opacity="0.4"/>
                    </Border.Shadow>
                    <Label x:Name="OrdersIcon" Text="📦" FontSize="22"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label x:Name="OrdersLabel" Text="Orders" FontSize="9"
                       TextColor="{StaticResource NavMuted}"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       Margin="0,42,0,0"/>
            </Grid>

            <!-- Chats -->
            <VerticalStackLayout Grid.Column="3"
                                 Spacing="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 x:Name="ChatsTab">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatsTabTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="ChatsIcon" Text="💬" FontSize="22"
                       HorizontalOptions="Center" Opacity="0.55"/>
                <Label x:Name="ChatsLabel" Text="Chats" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource NavMuted}"/>
                <BoxView x:Name="ChatsDot"
                         HeightRequest="4" WidthRequest="4"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Center">
                    <BoxView.Clip>
                        <RoundRectangleGeometry Rect="0,0,4,4" CornerRadius="2"/>
                    </BoxView.Clip>
                </BoxView>
            </VerticalStackLayout>

            <!-- Profile -->
            <VerticalStackLayout Grid.Column="4"
                                 Spacing="3"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 x:Name="ProfileTab">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTabTapped"/>
                </VerticalStackLayout.GestureRecognizers>
                <Label x:Name="ProfileIcon" Text="👤" FontSize="22"
                       HorizontalOptions="Center" Opacity="0.55"/>
                <Label x:Name="ProfileLabel" Text="Account" FontSize="10"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource NavMuted}"/>
                <BoxView x:Name="ProfileDot"
                         HeightRequest="4" WidthRequest="4"
                         BackgroundColor="Transparent"
                         HorizontalOptions="Center">
                    <BoxView.Clip>
                        <RoundRectangleGeometry Rect="0,0,4,4" CornerRadius="2"/>
                    </BoxView.Clip>
                </BoxView>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
