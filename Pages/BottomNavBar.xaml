<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.BottomNavBar">

    <!--
        Row 0 : 1px top border
        Row 1 : nav icons (fixed height — never changes)
        Row 2 : SystemBarSpacer — height set at runtime to exactly match the
                system navigation bar (3-button or gesture strip).
                White background fills behind the bar so no dark bleed-through.
    -->
    <Grid BackgroundColor="#FFFFFF"
          RowDefinitions="1,Auto,Auto"
          VerticalOptions="End">

        <!-- Top border -->
        <BoxView Grid.Row="0" BackgroundColor="#E9EDEF" HeightRequest="1"/>

        <!-- Nav items — padding is FIXED, height never changes -->
        <Grid x:Name="NavItemsGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*"
              Padding="4,8,4,10"
              BackgroundColor="#FFFFFF">

            <!-- ═══ UPDATES ═══ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto" RowSpacing="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUpdatesTapped"/>
                </Grid.GestureRecognizers>
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                    <BoxView x:Name="UpdatesPill" CornerRadius="16" BackgroundColor="#EFF6FF"
                             IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Path x:Name="UpdatesIcon"
                          Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                          Fill="#6B7280" WidthRequest="22" HeightRequest="22"
                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Ellipse x:Name="UpdatesBadge" WidthRequest="9" HeightRequest="9"
                             Fill="#F59E0B" Stroke="White" StrokeThickness="1.5"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,3,8,0" IsVisible="False"/>
                </Grid>
                <Label x:Name="UpdatesLabel" Grid.Row="1" Text="Updates"
                       FontSize="11" TextColor="#6B7280"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <!-- ═══ CONTACTS ═══ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnContactsTapped"/>
                </Grid.GestureRecognizers>
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                    <BoxView x:Name="ContactsPill" CornerRadius="16" BackgroundColor="#EFF6FF"
                             IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Path x:Name="ContactsIcon"
                          Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                          Fill="#6B7280" WidthRequest="22" HeightRequest="22"
                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Ellipse x:Name="ContactsBadge" WidthRequest="9" HeightRequest="9"
                             Fill="#F59E0B" Stroke="White" StrokeThickness="1.5"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,3,8,0" IsVisible="False"/>
                </Grid>
                <Label x:Name="ContactsLabel" Grid.Row="1" Text="Contacts"
                       FontSize="11" TextColor="#6B7280"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <!-- ═══ CHATS ═══ -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto" RowSpacing="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnChatsTapped"/>
                </Grid.GestureRecognizers>
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                    <BoxView x:Name="ChatsPill" CornerRadius="16" BackgroundColor="#EFF6FF"
                             IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Path x:Name="ChatsIcon"
                          Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"
                          Fill="#6B7280" WidthRequest="22" HeightRequest="22"
                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Ellipse x:Name="ChatsBadge" WidthRequest="9" HeightRequest="9"
                             Fill="#F59E0B" Stroke="White" StrokeThickness="1.5"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,3,8,0" IsVisible="False"/>
                </Grid>
                <Label x:Name="ChatsLabel" Grid.Row="1" Text="Chats"
                       FontSize="11" TextColor="#6B7280"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <!-- ═══ STORE ═══ -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStoreTapped"/>
                </Grid.GestureRecognizers>
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                    <BoxView x:Name="StorePill" CornerRadius="16" BackgroundColor="#EFF6FF"
                             IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Path x:Name="StoreIcon"
                          Data="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 4c0 .55-.45 1-1 1s-1-.45-1-1V8h2v2zm2-6c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm4 6c0 .55-.45 1-1 1s-1-.45-1-1V8h2v2z"
                          Fill="#6B7280" WidthRequest="22" HeightRequest="22"
                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>
                <Label x:Name="StoreLabel" Grid.Row="1" Text="Store"
                       FontSize="11" TextColor="#6B7280"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <!-- ═══ PROFILE ═══ -->
            <Grid Grid.Column="4" RowDefinitions="Auto,Auto" RowSpacing="3">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileTapped"/>
                </Grid.GestureRecognizers>
                <Grid Grid.Row="0" HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                    <BoxView x:Name="ProfilePill" CornerRadius="16" BackgroundColor="#EFF6FF"
                             IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                    <Path x:Name="ProfileIcon"
                          Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                          Fill="#6B7280" WidthRequest="22" HeightRequest="22"
                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Ellipse x:Name="ProfileBadge" WidthRequest="9" HeightRequest="9"
                             Fill="#F59E0B" Stroke="White" StrokeThickness="1.5"
                             HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,3,8,0" IsVisible="False"/>
                </Grid>
                <Label x:Name="ProfileLabel" Grid.Row="1" Text="Profile"
                       FontSize="11" TextColor="#6B7280"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

        </Grid>

        <!--
            Row 2: Spacer whose height is set in code-behind to match the
            system navigation bar height. White background continues here so
            there's no dark bleed-through behind the 3-button bar.
        -->
        <BoxView x:Name="SystemBarSpacer"
                 Grid.Row="2"
                 BackgroundColor="#FFFFFF"
                 HeightRequest="0"/>

    </Grid>
</ContentView>
