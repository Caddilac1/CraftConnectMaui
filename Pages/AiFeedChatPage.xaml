<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.AiFeedChatPage"
             xmlns:pagemodels="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
             x:DataType="pagemodels:AiFeedChatPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#ECE5DD">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:StringIsEmptyConverter x:Key="StringIsEmptyConverter"/>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root grid — main UI sits in Row 0; attachment overlay sits on top -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════
             MAIN LAYOUT
        ═════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0">

            <!-- ── WHATSAPP-STYLE HEADER ──────────────────────────── -->
            <Grid Grid.Row="0"
                  BackgroundColor="#075E54"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  RowSpacing="0">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="6,8,6,8"/>
                        <On Platform="iOS"     Value="6,48,6,8"/>
                    </OnPlatform>
                </Grid.Padding>

                <!-- Back arrow -->
                <Border Grid.Column="0"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="24"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- AI Avatar circle -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40"
                      VerticalOptions="Center" Margin="2,0,10,0">
                    <Border WidthRequest="40" HeightRequest="40"
                            BackgroundColor="#128C7E" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <!-- Robot/AI icon -->
                        <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="22"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <!-- Online green dot -->
                    <Border WidthRequest="12" HeightRequest="12"
                            BackgroundColor="#25D366" StrokeThickness="1.5"
                            HorizontalOptions="End" VerticalOptions="End">
                        <Border.Stroke>
                            <SolidColorBrush Color="#075E54"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                    </Border>
                </Grid>

                <!-- AI name + status -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label Text="Feed Assistant"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding StatusText}"
                           FontSize="12" TextColor="#B2DFDB"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Info icon -->
                <Border Grid.Column="3"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe88e;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- ── MESSAGES AREA — beige WhatsApp background ─────── -->
            <Grid Grid.Row="1" BackgroundColor="#ECE5DD">

                <RefreshView Command="{Binding RefreshCommand}"
                             IsRefreshing="{Binding IsBusy}"
                             RefreshColor="#075E54"
                             BackgroundColor="Transparent">

                    <CollectionView x:Name="MessagesCollectionView"
                                    ItemsSource="{Binding Messages}"
                                    SelectionMode="None"
                                    BackgroundColor="Transparent">

                        <CollectionView.Header>
                            <!-- "TODAY" date separator pill -->
                            <Grid Padding="0,10,0,6">
                                <Border BackgroundColor="White" StrokeThickness="0"
                                        Padding="14,4" HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label Text="TODAY" FontSize="12" TextColor="#667781"
                                           FontAttributes="Bold" CharacterSpacing="1.5"/>
                                </Border>
                            </Grid>
                        </CollectionView.Header>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40" VerticalOptions="Center"
                                                 HorizontalOptions="Center" Spacing="12">
                                <Border WidthRequest="72" HeightRequest="72"
                                        BackgroundColor="White" StrokeThickness="0"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="36"/>
                                    </Border.StrokeShape>
                                    <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="36"
                                           TextColor="#075E54" HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Assistant Ready" FontSize="16"
                                       TextColor="#546E7A" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Let's create an amazing feed post together!"
                                       FontSize="13" TextColor="#90A4AE"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pagemodels:AiChatMessageViewModel">
                                <Grid Padding="6,2,6,2">

                                    <!-- ── AI MESSAGES (LEFT) ──────────────── -->
                                    <VerticalStackLayout IsVisible="{Binding IsFromAi}"
                                                         HorizontalOptions="Start"
                                                         MaximumWidthRequest="290"
                                                         Spacing="0">

                                        <Label Text="Feed Assistant"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="#075E54"
                                               Margin="12,4,12,0"/>

                                        <!-- White bubble, sharp top-left corner -->
                                        <Border BackgroundColor="White"
                                                StrokeThickness="0"
                                                Padding="10,6,10,6"
                                                Margin="0,2,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,8,8,8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Message}"
                                                       FontSize="15" TextColor="#111B21"
                                                       LineBreakMode="WordWrap"/>
                                                <Label Text="{Binding DisplayTime}"
                                                       FontSize="11" TextColor="#667781"
                                                       HorizontalOptions="End" Margin="0,2,0,0"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Typing indicator (three dots) -->
                                        <Border IsVisible="{Binding IsTyping}"
                                                BackgroundColor="White" StrokeThickness="0"
                                                Padding="14,10" Margin="0,2,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,8,8,8"/>
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="5">
                                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="#9E9E9E" Opacity="0.4"/>
                                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="#9E9E9E" Opacity="0.6"/>
                                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="#9E9E9E" Opacity="0.4"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- ── USER MESSAGES (RIGHT) ───────────── -->
                                    <VerticalStackLayout IsVisible="{Binding IsFromUser}"
                                                         HorizontalOptions="End"
                                                         MaximumWidthRequest="290"
                                                         Spacing="0">

                                        <!-- Green bubble, sharp top-right corner -->
                                        <Border BackgroundColor="#DCF8C6"
                                                StrokeThickness="0"
                                                Padding="10,6,10,6"
                                                Margin="0,2,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8,0,8,8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Message}"
                                                       FontSize="15" TextColor="#111B21"
                                                       LineBreakMode="WordWrap"/>
                                                <HorizontalStackLayout HorizontalOptions="End"
                                                                        Spacing="3" Margin="0,2,0,0">
                                                    <Label Text="{Binding DisplayTime}"
                                                           FontSize="11" TextColor="#667781"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- ── FILE ATTACHMENT PREVIEW ─────────── -->
                                    <Border IsVisible="{Binding HasAttachment}"
                                            HorizontalOptions="{Binding AttachmentAlignment}"
                                            BackgroundColor="#F0F0F0"
                                            StrokeThickness="0"
                                            Padding="10,8" Margin="0,4,0,0"
                                            MaximumWidthRequest="270">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                                    BackgroundColor="#075E54" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Label Text="&#xe24d;" FontFamily="MaterialIcons" FontSize="24"
                                                       TextColor="White"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding AttachmentName}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="#111B21" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding AttachmentType}"
                                                       FontSize="11" TextColor="#667781"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- Loading spinner -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#075E54"
                                   WidthRequest="28" HeightRequest="28"
                                   VerticalOptions="Start" HorizontalOptions="Center"
                                   Margin="0,12,0,0" ZIndex="99"/>
            </Grid>

            <!-- ── ATTACHED FILES STRIP ───────────────────────────── -->
            <Border Grid.Row="2"
                    IsVisible="{Binding HasAttachedFiles}"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    HeightRequest="64"
                    Padding="8,4">
                <CollectionView ItemsSource="{Binding AttachedFiles}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F0F2F5" StrokeThickness="0"
                                    Padding="10,6" WidthRequest="130">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding FileName}" FontSize="11"
                                               FontAttributes="Bold" TextColor="#111B21"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding FileType}" FontSize="10"
                                               TextColor="#667781"/>
                                    </VerticalStackLayout>
                                    <!-- Remove file button -->
                                    <Label Grid.Column="1" Text="&#xe5cd;"
                                           FontFamily="MaterialIcons" FontSize="16"
                                           TextColor="#8696A0" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type pagemodels:AiFeedChatPageModel}}, Path=RemoveFileCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- ── WHATSAPP-STYLE INPUT BAR ───────────────────────── -->
            <Grid Grid.Row="3"
                  x:Name="MessageInputArea"
                  BackgroundColor="#F0F2F5"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="8,6,8,10"/>
                        <On Platform="Default" Value="8,6,8,6"/>
                    </OnPlatform>
                </Grid.Padding>

                <!-- White input pill -->
                <Border Grid.Column="0"
                        BackgroundColor="White" StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumHeightRequest="46" MaximumHeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0" Padding="6,0">

                        <!-- Emoji -->
                        <Border Grid.Column="0"
                                BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEmojiButtonTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe24e;" FontFamily="MaterialIcons" FontSize="24"
                                   TextColor="#8696A0" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <!-- Message editor -->
                        <Editor Grid.Column="1"
                                x:Name="MessageEditor"
                                Text="{Binding MessageText}"
                                Placeholder="Type a message"
                                AutoSize="TextChanges"
                                FontSize="16"
                                TextColor="#111B21"
                                PlaceholderColor="#8696A0"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                MinimumHeightRequest="28"
                                MaximumHeightRequest="100"/>

                        <!-- Attachment icon — only when no text typed -->
                        <Border Grid.Column="2"
                                BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="38" HeightRequest="38"
                                VerticalOptions="Center" Margin="0,0,6,0"
                                IsVisible="{Binding MessageText, Converter={StaticResource StringIsEmptyConverter}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAttachmentButtonTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe226;" FontFamily="MaterialIcons" FontSize="24"
                                   TextColor="#8696A0" Rotation="-45"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- ── SEND / MIC BUTTON ───────────────────────────── -->
                <!--
                    When text is present   → teal background, sends message on tap
                    When no text + idle    → teal background, starts recording on tap
                    When recording         → red background, stops recording on tap
                -->
                <Border x:Name="SendMicButton"
                        Grid.Column="1"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="{Binding SendButtonColor}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendMicTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Mic — idle, no text -->
                        <Label Text="&#xe029;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ShowMicIcon}"/>
                        <!-- Stop square — while recording -->
                        <Label Text="&#xe047;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsRecording}"/>
                        <!-- Send arrow — when text present -->
                        <Label Text="&#xe163;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding MessageText, Converter={StaticResource StringNotEmptyConverter}}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             RECORDING INDICATOR OVERLAY
             Slides up from bottom while recording is active.
        ═════════════════════════════════════════════════════════════ -->
        <Border x:Name="RecordingBanner"
                IsVisible="{Binding IsRecording}"
                BackgroundColor="#D32F2F"
                StrokeThickness="0"
                VerticalOptions="End"
                HorizontalOptions="FillAndExpand"
                Padding="20,12"
                Margin="0,0,0,70">
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <!-- Pulsing dot -->
                <Ellipse x:Name="RecordingDot"
                         WidthRequest="10" HeightRequest="10"
                         Fill="White" VerticalOptions="Center"/>
                <Label Text="Recording... tap ■ to stop &amp; send"
                       FontSize="13" TextColor="White" VerticalOptions="Center"/>
                <Label Text="{Binding RecordingDuration}"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             WHATSAPP-STYLE ATTACHMENT BOTTOM SHEET OVERLAY
        ═════════════════════════════════════════════════════════════ -->
        <Grid x:Name="AttachmentOverlay" IsVisible="False" BackgroundColor="Transparent">

            <!-- Dim background — tap to dismiss -->
            <BoxView BackgroundColor="Black" Opacity="0.6">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDismissAttachmentSheet"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- Bottom sheet panel -->
            <VerticalStackLayout VerticalOptions="End" Spacing="0">

                <!-- Drag handle -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        Padding="0,12,0,4" HorizontalOptions="FillAndExpand">
                    <Border BackgroundColor="#E0E0E0" WidthRequest="40" HeightRequest="4"
                            StrokeThickness="0" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2"/>
                        </Border.StrokeShape>
                    </Border>
                </Border>

                <!-- Options grid -->
                <Grid BackgroundColor="White"
                      Padding="24,8,24,32"
                      ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="20"
                      ColumnSpacing="16">

                    <!-- Document -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                         Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="58" HeightRequest="58"
                                BackgroundColor="#075E54" StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDocumentTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe24d;" FontFamily="MaterialIcons" FontSize="26"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Document" FontSize="12" TextColor="#424242"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Camera -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                         Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="58" HeightRequest="58"
                                BackgroundColor="#128C7E" StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCameraTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe3af;" FontFamily="MaterialIcons" FontSize="26"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Camera" FontSize="12" TextColor="#424242"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Gallery -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="2"
                                         Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="58" HeightRequest="58"
                                BackgroundColor="#25D366" StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGalleryTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe410;" FontFamily="MaterialIcons" FontSize="26"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Gallery" FontSize="12" TextColor="#424242"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Invoice -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                         Spacing="8" HorizontalOptions="Center">
                        <Border WidthRequest="58" HeightRequest="58"
                                BackgroundColor="#FF9800" StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInvoiceTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe8e0;" FontFamily="MaterialIcons" FontSize="26"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Invoice" FontSize="12" TextColor="#424242"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </Grid>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
