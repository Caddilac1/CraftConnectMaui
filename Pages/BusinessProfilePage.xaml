<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.BusinessProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Top bar ── -->
        <Grid Grid.Row="0" BackgroundColor="#1B2B3A" Padding="16,52,16,16"
              ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0" Source="chevron_left.png"
                         WidthRequest="24" HeightRequest="24"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="Business Profile"
                   TextColor="White" FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <ActivityIndicator x:Name="SaveIndicator" Grid.Column="2"
                               IsRunning="False" IsVisible="False"
                               Color="White" WidthRequest="22" HeightRequest="22"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#2E6FD8" HorizontalOptions="Center"
                                   Margin="0,40,0,0"/>

                <!-- ── Verification status (read-only) ── -->
                <Frame x:Name="VerificationCard" BackgroundColor="White" CornerRadius="14"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="#EBF3FB" CornerRadius="10"
                               Padding="0" HasShadow="False" WidthRequest="40" HeightRequest="40">
                            <Image Source="shield_check.png" WidthRequest="20" HeightRequest="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Verification Status" FontSize="14"
                                   FontAttributes="Bold" TextColor="#1B2B3A"/>
                            <Label x:Name="VerifiedDateLabel" FontSize="12" TextColor="#5A7184"/>
                        </VerticalStackLayout>
                        <Frame x:Name="VerificationBadge" Grid.Column="2"
                               CornerRadius="8" Padding="8,4" HasShadow="False">
                            <Label x:Name="VerificationStatusLabel" FontSize="12"
                                   FontAttributes="Bold" TextColor="White"/>
                        </Frame>
                    </Grid>
                </Frame>

                <!-- ── Legal & Credentials ── -->
                <Frame x:Name="LegalSection" BackgroundColor="White" CornerRadius="14"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="LEGAL &amp; CREDENTIALS" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <!-- License number -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="License Number" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="LicenseEntry" Placeholder="Your license number (if applicable)"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Certification -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Certification" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="CertificationEditor"
                                        Placeholder="List your certifications"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="70" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Business registration -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Business Registration Number" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="BusinessRegEntry" Placeholder="e.g. BN-12345678"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Tax ID -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tax ID / TIN" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="TaxIdEntry" Placeholder="Your tax identification number"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Insurance details -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Insurance Details" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="InsuranceEditor"
                                        Placeholder="Insurance provider, policy number, coverage details"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="90" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Info banner -->
                <Frame x:Name="InfoBanner" BackgroundColor="#EBF3FB" CornerRadius="12"
                       Padding="16" HasShadow="False" BorderColor="#BDD7F5"
                       IsVisible="False">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                        <Image Grid.Column="0" Source="info.png"
                               WidthRequest="18" HeightRequest="18"
                               VerticalOptions="Start" Margin="0,2,0,0"/>
                        <Label Grid.Column="1"
                               Text="These details are used for verification purposes only and are not visible on your public profile. Providing accurate information helps us verify your account faster."
                               FontSize="12" TextColor="#3D5166"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Frame>

                <!-- Save button -->
                <Button x:Name="SaveButton"
                        Text="Save Changes"
                        BackgroundColor="#2E6FD8"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        IsVisible="False"
                        Clicked="OnSaveClicked"
                        Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
