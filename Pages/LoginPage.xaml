<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.LoginPage"
             xmlns:pagemodels="clr-namespace:CraftConnect_Mobile_App.PageModels"
             x:DataType="pagemodels:LoginPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid>
        <!-- Background with gradient effect -->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*" />
            <RowDefinition Height="0.65*" />
        </Grid.RowDefinitions>

        <BoxView Grid.Row="0" Color="{StaticResource Primary}" />
        <BoxView Grid.Row="1" Color="{StaticResource White}" />

        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout 
                Padding="{OnPlatform Android='30,20,30,80', Default='30'}"
                Spacing="20"
                VerticalOptions="Center">

                <!-- Logo/App Header -->
                <VerticalStackLayout 
                    Spacing="16"
                    HorizontalOptions="Center"
                    Margin="0,0,0,20">

                    <!-- Logo Icon Container -->
                    <Frame 
                        BackgroundColor="{StaticResource White}"
                        CornerRadius="16"
                        HasShadow="True"
                        HeightRequest="70"
                        WidthRequest="70"
                        Padding="0"
                        HorizontalOptions="Center">
                        <Label
                            Text="🔧"
                            FontSize="40"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Frame>

                    <!-- App Title -->
                    <VerticalStackLayout Spacing="8">
                        <Label 
                            Text="CraftConnect"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource White}"/>

                        <Label 
                            Text="Connect with skilled artisans"
                            FontSize="14"
                            TextColor="{StaticResource White}"
                            HorizontalOptions="Center"
                            Opacity="0.9"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Login Card -->
                <Frame 
                    BackgroundColor="{StaticResource White}"
                    CornerRadius="20"
                    HasShadow="True"
                    Padding="28"
                    Margin="0,0,0,20">

                    <VerticalStackLayout Spacing="24">

                        <!-- Header -->
                        <VerticalStackLayout Spacing="8">
                            <Label 
                                Text="Welcome Back"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="{StaticResource OffBlack}"
                                HorizontalOptions="Start"/>

                            <Label 
                                Text="Sign in to your CraftConnect account"
                                FontSize="14"
                                TextColor="{StaticResource Gray500}"
                                HorizontalOptions="Start"/>
                        </VerticalStackLayout>

                        <!-- Auth Mode Badge -->
                        <Frame 
                            BackgroundColor="#FEF3C7"
                            BorderColor="Transparent"
                            CornerRadius="20"
                            Padding="8,6"
                            HasShadow="False"
                            HorizontalOptions="Start">
                            <Label 
                                Text="{Binding AuthModeBadge}"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#F59E0B"/>
                        </Frame>

                        <!-- Form -->
                        <VerticalStackLayout Spacing="20">

                            <!-- Email/Phone Input -->
                            <VerticalStackLayout Spacing="6">
                                <Label 
                                    Text="Email or Phone Number"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource OffBlack}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Email or Phone Number "/>
                                            <Span Text="*" TextColor="#EF4444"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Frame 
                                    BackgroundColor="#FEFEFE"
                                    BorderColor="{StaticResource Gray200}"
                                    CornerRadius="12"
                                    Padding="0"
                                    HasShadow="False">
                                    <Entry 
                                        Placeholder="Enter your email or phone number"
                                        Text="{Binding EmailOrPhone}"
                                        Keyboard="Email"
                                        TextColor="{StaticResource OffBlack}"
                                        PlaceholderColor="{StaticResource Gray400}"
                                        FontSize="15"
                                        Margin="16,14"/>
                                </Frame>

                                <Label 
                                    Text="You can use either your email address or phone number"
                                    FontSize="12"
                                    TextColor="{StaticResource Gray500}"
                                    Margin="4,2,0,0"/>
                            </VerticalStackLayout>

                            <!-- Password Section (Conditionally Visible) -->
                            <VerticalStackLayout 
                                Spacing="6"
                                IsVisible="{Binding IsPasswordMode}">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label 
                                        Grid.Column="0"
                                        Text="Password"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource OffBlack}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Password "/>
                                                <Span Text="*" TextColor="#EF4444"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label 
                                        Grid.Column="1"
                                        Text="Forgot?"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource Primary}"
                                        HorizontalOptions="End">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding ForgotPasswordCommand}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <Frame 
                                    BackgroundColor="#FEFEFE"
                                    BorderColor="{StaticResource Gray200}"
                                    CornerRadius="12"
                                    Padding="0"
                                    HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto" Margin="16,14">
                                        <Entry 
                                            Grid.Column="0"
                                            Placeholder="Enter your password"
                                            Text="{Binding Password}"
                                            IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                            TextColor="{StaticResource OffBlack}"
                                            PlaceholderColor="{StaticResource Gray400}"
                                            FontSize="15"/>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding IsPasswordVisible, Converter={StaticResource PasswordTextConverter}}"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Gray500}"
                                            VerticalOptions="Center"
                                            Padding="10,6">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding TogglePasswordVisibilityCommand}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Remember Me (Only visible in password mode) -->
                            <HorizontalStackLayout 
                                Spacing="10"
                                IsVisible="{Binding IsPasswordMode}">
                                <CheckBox 
                                    IsChecked="{Binding RememberMe}"
                                    Color="{StaticResource Primary}"/>
                                <Label 
                                    Text="Remember me"
                                    FontSize="14"
                                    FontAttributes="None"
                                    TextColor="{StaticResource Gray500}"
                                    VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Error Message -->
                            <Frame 
                                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#FEE2E2"
                                BorderColor="#FCA5A5"
                                CornerRadius="10"
                                Padding="14,12"
                                HasShadow="False">
                                <Label 
                                    Text="{Binding ErrorMessage}"
                                    TextColor="#991B1B"
                                    FontSize="13"
                                    FontAttributes="None"
                                    LineBreakMode="WordWrap"/>
                            </Frame>

                            <!-- Success Message -->
                            <Frame 
                                IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#D1FAE5"
                                BorderColor="#6EE7B7"
                                CornerRadius="10"
                                Padding="14,12"
                                HasShadow="False">
                                <Label 
                                    Text="{Binding SuccessMessage}"
                                    TextColor="#065F46"
                                    FontSize="13"
                                    FontAttributes="None"
                                    LineBreakMode="WordWrap"/>
                            </Frame>

                            <!-- Info Message -->
                            <Frame 
                                IsVisible="{Binding InfoMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                BackgroundColor="#DBEAFE"
                                BorderColor="#93C5FD"
                                CornerRadius="10"
                                Padding="14,12"
                                HasShadow="False">
                                <Label 
                                    Text="{Binding InfoMessage}"
                                    TextColor="#1E40AF"
                                    FontSize="13"
                                    FontAttributes="None"
                                    LineBreakMode="WordWrap"/>
                            </Frame>

                            <!-- Main Action Button -->
                            <Button 
                                Text="{Binding MainButtonText}"
                                Command="{Binding MainActionCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="56"
                                FontSize="16"
                                FontAttributes="Bold"
                                Margin="0,8,0,0">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" 
                                                 Binding="{Binding IsBusy}" 
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!-- Toggle Auth Mode Button -->
                            <Button 
                                Text="{Binding ToggleButtonText}"
                                Command="{Binding ToggleAuthModeCommand}"
                                BackgroundColor="White"
                                TextColor="{StaticResource Primary}"
                                BorderColor="{StaticResource Gray200}"
                                BorderWidth="2"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontSize="15"
                                FontAttributes="Bold"
                                Margin="0,0,0,0">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" 
                                                 Binding="{Binding IsBusy}" 
                                                 Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <!-- Loading Indicator -->
                            <ActivityIndicator 
                                IsRunning="{Binding IsBusy}"
                                IsVisible="{Binding IsBusy}"
                                Color="{StaticResource Primary}"
                                HorizontalOptions="Center"
                                HeightRequest="24"
                                WidthRequest="24"
                                Margin="0,12"/>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Sign Up Link -->
                <Frame 
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    Padding="0"
                    HasShadow="False"
                    HorizontalOptions="Center">
                    <HorizontalStackLayout 
                        HorizontalOptions="Center"
                        Spacing="6">

                        <Label 
                            Text="Don't have an account?"
                            FontSize="15"
                            TextColor="{StaticResource Gray500}"/>

                        <Label 
                            Text="Create An Account"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding NavigateToSignUpCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Frame>

                <!-- Hidden Test Connection Button -->
                <Button 
                    Text=""
                    Command="{Binding TestConnectionCommand}"
                    BackgroundColor="Transparent"
                    HeightRequest="1"
                    IsVisible="False"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>