<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CraftConnect_Mobile_App.Controls"
             x:Class="CraftConnect_Mobile_App.Pages.SettingsPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ── Dark Header ── -->
                <Grid BackgroundColor="#1B2B3A"
                      Padding="20,60,20,40"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="6">

                    <!-- Avatar: overlapping frames — photo on top of initials -->
                    <Grid Grid.Row="0"
                          WidthRequest="90"
                          HeightRequest="90"
                          HorizontalOptions="Center">

                        <!-- Initials frame (default, always behind) -->
                        <Frame x:Name="AvatarInitialsFrame"
                               WidthRequest="90"
                               HeightRequest="90"
                               CornerRadius="45"
                               Padding="0"
                               HasShadow="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsClippedToBounds="True">
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4DA6E8" Offset="0"/>
                                    <GradientStop Color="#2E6FD8" Offset="1"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                            <Label x:Name="AvatarInitialsLabel"
                                   Text="?"
                                   TextColor="White"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Real photo frame (hidden until photo loaded) -->
                        <Frame x:Name="AvatarPhotoFrame"
                               WidthRequest="90"
                               HeightRequest="90"
                               CornerRadius="45"
                               Padding="0"
                               HasShadow="False"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsClippedToBounds="True"
                               IsVisible="False">
                            <Image x:Name="AvatarImage"
                                   Aspect="AspectFill"
                                   WidthRequest="90"
                                   HeightRequest="90"/>
                        </Frame>

                        <!-- Camera badge bottom-right -->
                        <Border WidthRequest="28"
                                HeightRequest="28"
                                StrokeThickness="2"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Border.Stroke>
                                <SolidColorBrush Color="#1B2B3A"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Border.Background>
                                <SolidColorBrush Color="#2DC98E"/>
                            </Border.Background>
                            <Label Text="📷"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChangePhotoClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                    </Grid>

                    <Label Grid.Row="1"
                           x:Name="UserNameLabel"
                           Text="User"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Label Grid.Row="2"
                           x:Name="UserEmailLabel"
                           Text=""
                           TextColor="#A0B4C8"
                           FontSize="14"
                           HorizontalOptions="Center"/>
                </Grid>

                <!-- ── Content Area ── -->
                <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                    <!-- ACCOUNT Section -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="ACCOUNT"
                               TextColor="#8A9BAD"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="4,0,0,8"
                               CharacterSpacing="1.2"/>

                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#E8EDF2">
                            <VerticalStackLayout Spacing="0">

                                <!-- Profile Settings -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="person.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Profile Settings"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProfileSettingsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Edit Profile -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="edit.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Edit Profile"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditProfileClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Notifications -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="bell.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Notifications"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNotificationsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- ARTISAN Section (hidden for non-artisans) -->
                    <VerticalStackLayout x:Name="ArtisanSectionContainer" Spacing="0" IsVisible="False">
                        <Label Text="ARTISAN"
                               TextColor="#8A9BAD"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="4,0,0,8"
                               CharacterSpacing="1.2"/>

                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#E8EDF2">
                            <VerticalStackLayout Spacing="0">

                                <!-- Business Profile -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="briefcase.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Business Profile"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditBusinessClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Availability -->
                                <Grid ColumnDefinitions="44,*,Auto"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="availability.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Availability"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Switch x:Name="AvailabilitySwitch"
                                            Grid.Column="2"
                                            OnColor="#10B981"
                                            ThumbColor="White"
                                            IsToggled="True"
                                            Toggled="OnAvailabilityToggled"/>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- ADMIN Section (hidden for non-admins) -->
                    <VerticalStackLayout x:Name="AdminSectionContainer" Spacing="0" IsVisible="False">
                        <Label Text="ADMINISTRATION"
                               TextColor="#8A9BAD"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="4,0,0,8"
                               CharacterSpacing="1.2"/>

                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#E8EDF2">
                            <VerticalStackLayout Spacing="0">

                                <!-- Manage Users -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="users.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Manage Users"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnManageUsersClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Reports -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="chart.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="View Reports"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewReportsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Verifications -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="shield_check.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Artisan Verifications"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnVerificationsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- SECURITY Section -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="SECURITY"
                               TextColor="#8A9BAD"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="4,0,0,8"
                               CharacterSpacing="1.2"/>

                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#E8EDF2">
                            <VerticalStackLayout Spacing="0">

                                <!-- Privacy & Security -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="lock.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Privacy &amp; Security"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPrivacySecurityClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Payment Methods -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="card.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Payment Methods"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPaymentMethodsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- SUPPORT Section -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="SUPPORT"
                               TextColor="#8A9BAD"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="4,0,0,8"
                               CharacterSpacing="1.2"/>

                        <Frame BackgroundColor="White"
                               CornerRadius="14"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#E8EDF2">
                            <VerticalStackLayout Spacing="0">

                                <!-- Help & Support -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="help_circle.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Help &amp; Support"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHelpClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- Terms -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="document.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="Terms &amp; Conditions"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTermsClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                                <!-- About -->
                                <Grid ColumnDefinitions="44,*,24"
                                      Padding="16,14"
                                      ColumnSpacing="12">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF3FB"
                                           CornerRadius="10"
                                           Padding="0"
                                           HasShadow="False"
                                           WidthRequest="36"
                                           HeightRequest="36">
                                        <Image Source="info.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1"
                                           Text="About"
                                           FontSize="15"
                                           TextColor="#1B2B3A"
                                           VerticalOptions="Center"/>
                                    <Image Grid.Column="2"
                                           Source="chevron_right.png"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAboutClicked"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Logout Button -->
                    <Frame BackgroundColor="#FEF2F2"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False"
                           BorderColor="#FECACA"
                           Margin="0,4,0,0">
                        <Grid ColumnDefinitions="Auto,*"
                              Padding="20,16"
                              ColumnSpacing="12">
                            <Image Grid.Column="0"
                                   Source="logout.png"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Logout"
                                   TextColor="#EF4444"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Frame>

                    <!-- Delete Account -->
                    <Label Text="Delete Account"
                           TextColor="#EF4444"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,4,0,16"
                           TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteAccountClicked"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Nav Bar pinned at bottom -->
        <controls:BottomNavBar Grid.Row="1"
                               ActiveTab="Settings"
                               VerticalOptions="End"/>

    </Grid>
</ContentPage>
