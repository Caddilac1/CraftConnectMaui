<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CraftConnect_Mobile_App.Pages.EditArtisanProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pm="clr-namespace:CraftConnect_Mobile_App.PageModels"
    xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
    x:DataType="pm:EditArtisanProfilePageModel"
    BackgroundColor="#F7F3EE"
    Title="Edit Profile">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- ── Colours ─────────────────────────────────────────── -->
            <Color x:Key="Ink">#1A1612</Color>
            <Color x:Key="Parchment">#F7F3EE</Color>
            <Color x:Key="Cream">#EDE8E0</Color>
            <Color x:Key="Copper">#B5651D</Color>
            <Color x:Key="CopperLight">#D4843E</Color>
            <Color x:Key="CopperDim">#7A4012</Color>
            <Color x:Key="Sage">#5A6E52</Color>
            <Color x:Key="WarmGrey">#8A8078</Color>
            <Color x:Key="BorderColor">#D8CFC4</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="SageLight">#EAF4EA</Color>
            <Color x:Key="PrefilledBg">#F0EDE8</Color>
            <Color x:Key="PrefilledText">#5A5248</Color>
            <Color x:Key="PrefilledBorderColor">#C8BFB4</Color>

            <!-- ── Converters ──────────────────────────────────────── -->
            <converters:InverseBoolConverter   x:Key="InverseBool"/>
            <converters:BoolToStringConverter  x:Key="SaveBtnText"
                TrueValue="Save &amp; Continue to Proposal"
                FalseValue="Save Changes"/>
            <converters:BoolToStringConverter  x:Key="PageTitleText"
                TrueValue="Become an Artisan"
                FalseValue="Update Artisan Profile"/>

            <!-- ── Card ───────────────────────────────────────────── -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardColor}"/>
                <Setter Property="Stroke"          Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape"     Value="RoundRectangle 14"/>
                <Setter Property="Padding"         Value="20"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#1A1612" Offset="0,2" Radius="8" Opacity="0.08"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Section label ──────────────────────────────────── -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontFamily"      Value="DMSerifDisplay"/>
                <Setter Property="FontSize"        Value="18"/>
                <Setter Property="TextColor"       Value="{StaticResource Ink}"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <!-- ── Field label ────────────────────────────────────── -->
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize"         Value="11"/>
                <Setter Property="FontAttributes"   Value="Bold"/>
                <Setter Property="TextColor"        Value="{StaticResource Ink}"/>
                <Setter Property="CharacterSpacing" Value="1.2"/>
                <Setter Property="TextTransform"    Value="Uppercase"/>
                <Setter Property="Margin"           Value="0,0,0,4"/>
            </Style>

            <!-- ── Normal entry ───────────────────────────────────── -->
            <Style x:Key="FieldEntry" TargetType="Entry">
                <Setter Property="BackgroundColor"  Value="{StaticResource Parchment}"/>
                <Setter Property="TextColor"        Value="{StaticResource Ink}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource WarmGrey}"/>
                <Setter Property="FontSize"         Value="14"/>
                <Setter Property="Margin"           Value="0"/>
            </Style>

            <!-- ── Pre-filled entry ───────────────────────────────── -->
            <Style x:Key="PrefilledEntry" TargetType="Entry">
                <Setter Property="BackgroundColor"  Value="{StaticResource PrefilledBg}"/>
                <Setter Property="TextColor"        Value="{StaticResource PrefilledText}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource WarmGrey}"/>
                <Setter Property="FontSize"         Value="14"/>
                <Setter Property="Margin"           Value="0"/>
            </Style>

            <!-- ── Editor ─────────────────────────────────────────── -->
            <Style x:Key="FieldEditor" TargetType="Editor">
                <Setter Property="BackgroundColor"      Value="{StaticResource Parchment}"/>
                <Setter Property="TextColor"            Value="{StaticResource Ink}"/>
                <Setter Property="PlaceholderColor"     Value="{StaticResource WarmGrey}"/>
                <Setter Property="FontSize"             Value="14"/>
                <Setter Property="AutoSize"             Value="TextChanges"/>
                <Setter Property="MinimumHeightRequest" Value="90"/>
            </Style>

            <!-- ── Normal border ──────────────────────────────────── -->
            <Style x:Key="FieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Parchment}"/>
                <Setter Property="Stroke"          Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeShape"     Value="RoundRectangle 8"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>

            <!-- ── Pre-filled border ──────────────────────────────── -->
            <Style x:Key="PrefilledFieldBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource PrefilledBg}"/>
                <Setter Property="Stroke"          Value="{StaticResource PrefilledBorderColor}"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeShape"     Value="RoundRectangle 8"/>
                <Setter Property="Padding"         Value="4,2"/>
            </Style>

            <!-- ── Buttons ────────────────────────────────────────── -->
            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Copper}"/>
                <Setter Property="TextColor"       Value="White"/>
                <Setter Property="FontAttributes"  Value="Bold"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="24,12"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="{StaticResource Copper}" Offset="0,2" Radius="8" Opacity="0.3"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor"       Value="{StaticResource WarmGrey}"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="BorderColor"     Value="{StaticResource BorderColor}"/>
                <Setter Property="BorderWidth"     Value="1.5"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="22,11"/>
            </Style>

            <Style x:Key="Hint" TargetType="Label">
                <Setter Property="FontSize"  Value="11"/>
                <Setter Property="TextColor" Value="{StaticResource WarmGrey}"/>
                <Setter Property="Margin"    Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="16,0,16,48">

                <!-- ══ PROPOSAL-REDIRECT BANNER ══════════════════════ -->
                <Border IsVisible="{Binding IsProposalRedirect}"
                        Margin="0,20,0,0" Padding="16"
                        StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource CopperLight}"
                        StrokeThickness="1.5"
                        BackgroundColor="#1AB5651D">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource Copper}"
                                StrokeShape="RoundRectangle 18"
                                WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0"
                                VerticalOptions="Start">
                            <Label Text="ℹ" FontSize="18" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                            <Label Text="One more step before submitting your proposal"
                                   FontAttributes="Bold" FontSize="14"
                                   TextColor="{StaticResource CopperDim}"/>
                            <Label FontSize="13" TextColor="{StaticResource Ink}"
                                   LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Your personal details are pre-filled — just complete the "/>
                                        <Span Text="Business Information" FontAttributes="Italic"/>
                                        <Span Text=" section below and tap "/>
                                        <Span Text="Save &amp; Continue" FontAttributes="Bold"/>
                                        <Span Text=" to return to your proposal."/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- ══ PAGE HEADER ════════════════════════════════════ -->
                <VerticalStackLayout Margin="0,32,0,20" Spacing="2">
                    <Label Text="CRAFTCONNECT · ARTISAN PORTAL"
                           FontSize="10" FontAttributes="Bold"
                           CharacterSpacing="2" TextTransform="Uppercase"
                           TextColor="{StaticResource Copper}"/>
                    <Label Text="{Binding IsNewArtisanProfile, Converter={StaticResource PageTitleText}}"
                           FontFamily="DMSerifDisplay" FontSize="30"
                           TextColor="{StaticResource Ink}"/>
                </VerticalStackLayout>

                <!-- ══ USER CARD (pre-fill preview) ══════════════════ -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 32"
                                Stroke="{StaticResource CopperLight}"
                                StrokeThickness="2.5"
                                BackgroundColor="{StaticResource Cream}"
                                WidthRequest="58" HeightRequest="58">
                            <Grid>
                                <Label Text="{Binding Initials}"
                                       IsVisible="{Binding HasProfilePicture, Converter={StaticResource InverseBool}}"
                                       FontFamily="DMSerifDisplay" FontSize="22"
                                       TextColor="{StaticResource Copper}"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Image Source="{Binding ProfilePictureUrl}"
                                       IsVisible="{Binding HasProfilePicture}"
                                       Aspect="AspectFill"/>
                            </Grid>
                        </Border>

                        <!-- Name + email + phone -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding DisplayName}"
                                   FontFamily="DMSerifDisplay" FontSize="17"
                                   TextColor="{StaticResource Ink}"/>
                            <Label TextColor="{StaticResource WarmGrey}" FontSize="12"
                                   LineBreakMode="TailTruncation">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Email}"/>
                                        <Span Text=" · "/>
                                        <Span Text="{Binding PhoneNumber}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- "Details pre-filled" badge -->
                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource SageLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 99"
                                Padding="8,4" VerticalOptions="Center">
                            <Label Text="✓  Details pre-filled"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{StaticResource Sage}"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- ══ STEPS INDICATOR ════════════════════════════════ -->
                <Border Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource CardColor}"
                        Margin="0,0,0,28"
                        Padding="0">
                    <Grid ColumnDefinitions="*,*,*">

                        <!-- Step 1 — done -->
                        <Border Grid.Column="0"
                                BackgroundColor="#EAF4EA"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0"
                                Padding="12,14">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource Sage}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        WidthRequest="22" HeightRequest="22">
                                    <Label Text="✓" FontSize="11" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Account Created"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource Sage}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Step 2 — active -->
                        <Border Grid.Column="1"
                                BackgroundColor="#FDF4EC"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0"
                                Padding="12,14">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource Copper}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        WidthRequest="22" HeightRequest="22">
                                    <Label Text="2" FontSize="11" FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Business Details"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource CopperDim}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Step 3 — future -->
                        <Border Grid.Column="2"
                                BackgroundColor="{StaticResource CardColor}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0"
                                Padding="12,14">
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource Cream}"
                                        Stroke="{StaticResource BorderColor}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 11"
                                        WidthRequest="22" HeightRequest="22">
                                    <Label Text="3" FontSize="11"
                                           TextColor="{StaticResource WarmGrey}"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Start Bidding"
                                       FontSize="12"
                                       TextColor="{StaticResource WarmGrey}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                    </Grid>
                </Border>

                <!-- ════════════════════════════════════════════════════
                     SECTION 1 — PERSONAL DETAILS  (pre-filled)
                ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Cream}"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                WidthRequest="34" HeightRequest="34" Padding="8">
                            <Label Text="👤" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Personal Details"
                                   Style="{StaticResource SectionLabel}"/>
                            <Label Text="— pre-filled from your account"
                                   FontSize="11" FontAttributes="Italic"
                                   TextColor="{StaticResource WarmGrey}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="16">

                            <!-- Full Name -->
                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Spacing="0" Margin="0,0,0,4">
                                    <Label Text="FULL NAME"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}"
                                           CharacterSpacing="1.2"/>
                                    <Border BackgroundColor="{StaticResource SageLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="6,2" Margin="8,0,0,0">
                                        <Label Text="pre-filled" FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Sage}"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Border Style="{StaticResource PrefilledFieldBorder}">
                                    <Entry Text="{Binding FullName}"
                                           Style="{StaticResource PrefilledEntry}"
                                           Placeholder="Your full name"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Phone Number -->
                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Spacing="0" Margin="0,0,0,4">
                                    <Label Text="PHONE NUMBER"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}"
                                           CharacterSpacing="1.2"/>
                                    <Border BackgroundColor="{StaticResource SageLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="6,2" Margin="8,0,0,0">
                                        <Label Text="pre-filled" FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Sage}"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Border Style="{StaticResource PrefilledFieldBorder}">
                                    <Entry Text="{Binding PhoneNumber}"
                                           Keyboard="Telephone"
                                           Style="{StaticResource PrefilledEntry}"
                                           Placeholder="+233…"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Personal Address -->
                            <VerticalStackLayout Spacing="0">
                                <HorizontalStackLayout Spacing="0" Margin="0,0,0,4">
                                    <Label Text="PERSONAL ADDRESS"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}"
                                           CharacterSpacing="1.2"/>
                                    <Border BackgroundColor="{StaticResource SageLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="6,2" Margin="8,0,0,0">
                                        <Label Text="pre-filled" FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Sage}"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <Border Style="{StaticResource PrefilledFieldBorder}">
                                    <Entry Text="{Binding Address}"
                                           Style="{StaticResource PrefilledEntry}"
                                           Placeholder="Your home / personal address"/>
                                </Border>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════════════════════════════════════════════════
                     SECTION 2 — BUSINESS INFORMATION
                ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Cream}"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                WidthRequest="34" HeightRequest="34" Padding="8">
                            <Label Text="🏢" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="Business Information"
                                   Style="{StaticResource SectionLabel}"/>
                            <Label Text="(new — fill to activate)"
                                   IsVisible="{Binding IsNewArtisanProfile}"
                                   FontSize="11"
                                   TextColor="{StaticResource Copper}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="16">

                            <!-- Business Name * -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="BUSINESS NAME "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding BusinessName}"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="Your trading / business name"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Trade / Specialization * -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="TRADE / SPECIALIZATION "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Picker Title="— Select your trade —"
                                            ItemsSource="{Binding TradeOptions}"
                                            SelectedItem="{Binding Specialization}"
                                            TextColor="{StaticResource Ink}"
                                            TitleColor="{StaticResource WarmGrey}"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Business Description * (maps to ProfessionalBio) -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="BUSINESS DESCRIPTION "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Editor Text="{Binding ProfessionalBio}"
                                            Style="{StaticResource FieldEditor}"
                                            Placeholder="Describe your services, experience, and what makes you stand out…"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Business Address * -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="BUSINESS ADDRESS "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding BusinessAddress}"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="Physical address of your business"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Business Phone -->
                            <VerticalStackLayout Spacing="0">
                                <Label Text="BUSINESS PHONE" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding BusinessPhone}"
                                           Keyboard="Telephone"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="Business contact number"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Business Email -->
                            <VerticalStackLayout Spacing="0">
                                <Label Text="BUSINESS EMAIL" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding BusinessEmail}"
                                           Keyboard="Email"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="Business email address"/>
                                </Border>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ════════════════════════════════════════════════════
                     SECTION 3 — PRIMARY BUSINESS LOCATION
                ════════════════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,28">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Cream}"
                                StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                WidthRequest="34" HeightRequest="34" Padding="8">
                            <Label Text="📍" FontSize="15"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Column="1"
                               Text="Primary Business Location"
                               Style="{StaticResource SectionLabel}"/>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="16">

                            <!-- Location Name * -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="LOCATION NAME "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding LocationName}"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="e.g. Main Workshop, Downtown Office"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Location Address * -->
                            <VerticalStackLayout Spacing="0">
                                <Label Style="{StaticResource FieldLabel}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="LOCATION ADDRESS "/>
                                            <Span Text="*" TextColor="{StaticResource Copper}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Style="{StaticResource FieldBorder}">
                                    <Entry Text="{Binding LocationAddress}"
                                           Style="{StaticResource FieldEntry}"
                                           Placeholder="Street address of this location"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Town / City  +  Location Phone (side by side) -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                    <Label Style="{StaticResource FieldLabel}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="TOWN / CITY "/>
                                                <Span Text="*" TextColor="{StaticResource Copper}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding LocationTown}"
                                               Style="{StaticResource FieldEntry}"
                                               Placeholder="e.g. Accra"/>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                    <Label Text="LOCATION PHONE"
                                           Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource FieldBorder}">
                                        <Entry Text="{Binding LocationPhone}"
                                               Keyboard="Telephone"
                                               Style="{StaticResource FieldEntry}"
                                               Placeholder="Phone for this location"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Info box -->
                    <Border BackgroundColor="#FDF4EC"
                            Stroke="#E8C99A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="16,14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="As a verified artisan you'll be able to:"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource CopperDim}"/>
                            <VerticalStackLayout Spacing="5">
                                <Label Style="{StaticResource Hint}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="✦  " TextColor="{StaticResource Copper}"/>
                                            <Span Text="Submit proposals and bid on jobs posted on CraftConnect"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource Hint}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="✦  " TextColor="{StaticResource Copper}"/>
                                            <Span Text="Manage multiple locations and service areas"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource Hint}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="✦  " TextColor="{StaticResource Copper}"/>
                                            <Span Text="Track completed projects and build your reputation"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Style="{StaticResource Hint}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="✦  " TextColor="{StaticResource Copper}"/>
                                            <Span Text="Access performance analytics and client reviews"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- ══ ACTIONS BAR ════════════════════════════════════ -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                      Padding="0,16,0,0">
                    <Label Grid.Column="0"
                           Text="← Back to Profile"
                           VerticalOptions="Center"
                           TextColor="{StaticResource WarmGrey}"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView Grid.Column="1"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource GhostBtn}"
                            Text="Cancel"
                            Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryBtn}"
                            Text="{Binding IsProposalRedirect, Converter={StaticResource SaveBtnText}}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Saving overlay -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Copper}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

        <!-- Toast -->
        <Border x:Name="ToastOverlay"
                IsVisible="False"
                BackgroundColor="#CC1A1612"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Padding="20,12"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,40">
            <Label x:Name="ToastLabel"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"/>
        </Border>
    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save"
                     Command="{Binding SaveCommand}"
                     Order="Primary" Priority="0"/>
    </ContentPage.ToolbarItems>

</ContentPage>
