<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.MyProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F1923">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TOP BAR                                                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" BackgroundColor="#0F1923"
              Padding="20,52,20,16"
              ColumnDefinitions="44,*,44">

            <!-- Back -->
            <Frame Grid.Column="0"
                   BackgroundColor="#1C2B3A" CornerRadius="12"
                   Padding="0" HasShadow="False"
                   WidthRequest="38" HeightRequest="38"
                   VerticalOptions="Center">
                <ImageButton Source="chevron_left.png"
                             WidthRequest="16" HeightRequest="16"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <!-- Title -->
            <Label Grid.Column="1" Text="My Profile"
                   TextColor="#FFFFFF" FontSize="17" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   CharacterSpacing="0.3"/>

            <!-- Edit icon -->
            <Frame Grid.Column="2"
                   BackgroundColor="#1C2B3A" CornerRadius="12"
                   Padding="0" HasShadow="False"
                   WidthRequest="38" HeightRequest="38"
                   VerticalOptions="Center">
                <ImageButton Source="edit.png"
                             WidthRequest="16" HeightRequest="16"
                             BackgroundColor="Transparent"
                             Clicked="OnEditClicked"
                             HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>
        </Grid>

        <!-- Top bar divider -->
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                 Margin="0,0">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="0.3"/>
                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                    <GradientStop Color="#2563EB" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SCROLLABLE BODY                                             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" Padding="16,20,16,48">

                <!-- ── Loading ── -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#3B82F6"
                                   HorizontalOptions="Center"
                                   Margin="0,100,0,0"/>

                <!-- ── Error state ── -->
                <VerticalStackLayout x:Name="ErrorState" IsVisible="False"
                                     Spacing="16" HorizontalOptions="Center"
                                     Margin="0,80,0,0">
                    <Label Text="⚠" FontSize="48"
                           HorizontalOptions="Center" TextColor="#3B82F6"/>
                    <Label x:Name="ErrorLabel" Text="Could not load profile."
                           FontSize="15" TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Frame BackgroundColor="#1C2B3A" CornerRadius="12"
                           Padding="28,11" HasShadow="False"
                           HorizontalOptions="Center"
                           BorderColor="#2563EB">
                        <Label Text="Try Again" TextColor="#3B82F6"
                               FontSize="14" FontAttributes="Bold"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRetryClicked"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- HERO CARD                                          -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="ProfileCard"
                       CornerRadius="20" Padding="0"
                       HasShadow="False" BorderColor="#1C2B3A"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#131F2E" Offset="0"/>
                            <GradientStop Color="#172030" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>

                    <VerticalStackLayout Spacing="0">

                        <!-- Blue accent top line -->
                        <BoxView HeightRequest="2">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="0.3"/>
                                    <GradientStop Color="#60A5FA" Offset="0.5"/>
                                    <GradientStop Color="#2563EB" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <VerticalStackLayout Spacing="16" Padding="24,24,24,24">

                            <!-- Avatar + Verified -->
                            <Grid WidthRequest="104" HeightRequest="104"
                                  HorizontalOptions="Center">

                                <!-- Ring -->
                                <Frame WidthRequest="104" HeightRequest="104"
                                       CornerRadius="52" Padding="2.5"
                                       HasShadow="False"
                                       BackgroundColor="Transparent">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#60A5FA" Offset="0.5"/>
                                            <GradientStop Color="#1D4ED8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Frame WidthRequest="97" HeightRequest="97"
                                           CornerRadius="48" Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="#0F1923">
                                        <Label Text=" "/>
                                    </Frame>
                                </Frame>

                                <!-- Initials -->
                                <Frame x:Name="ProfileInitialsFrame"
                                       WidthRequest="97" HeightRequest="97"
                                       CornerRadius="48" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E3A5F" Offset="0"/>
                                            <GradientStop Color="#172030" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label x:Name="ProfileInitialsLabel" Text="?"
                                           FontSize="36" FontAttributes="Bold"
                                           TextColor="#60A5FA"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>

                                <!-- Photo -->
                                <Frame x:Name="ProfilePhotoFrame"
                                       WidthRequest="97" HeightRequest="97"
                                       CornerRadius="48" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="False">
                                    <Image x:Name="ProfilePhoto"
                                           Aspect="AspectFill"
                                           WidthRequest="97" HeightRequest="97"/>
                                </Frame>

                                <!-- Verified badge -->
                                <Frame x:Name="VerifiedBadge"
                                       WidthRequest="28" HeightRequest="28"
                                       CornerRadius="14" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="End" VerticalOptions="End"
                                       Margin="0,0,2,2"
                                       IsVisible="False"
                                       BackgroundColor="#16A34A">
                                    <Label Text="✓" TextColor="White"
                                           FontSize="13" FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </Grid>

                            <!-- Name -->
                            <Label x:Name="ProfileNameLabel" Text="User"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="0.2"/>

                            <!-- Role badge -->
                            <Frame x:Name="RoleBadgeFrame"
                                   CornerRadius="16" Padding="16,5"
                                   HasShadow="False"
                                   HorizontalOptions="Center"
                                   BackgroundColor="#1D3461"
                                   BorderColor="#2563EB">
                                <Label x:Name="RoleBadgeLabel"
                                       FontSize="10" FontAttributes="Bold"
                                       TextColor="#60A5FA"
                                       CharacterSpacing="1.8"/>
                            </Frame>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" BackgroundColor="#1C2B3A"
                                     Margin="0,2"/>

                            <!-- Contact row: email | phone/member -->
                            <Grid ColumnDefinitions="*,1,*" ColumnSpacing="0">

                                <!-- Email -->
                                <VerticalStackLayout Grid.Column="0"
                                                     HorizontalOptions="Center"
                                                     Spacing="3">
                                    <Label Text="✉" FontSize="13"
                                           TextColor="#3B82F6"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="ProfileEmailLabel" Text=""
                                           FontSize="11" TextColor="#64748B"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="MiddleTruncation"/>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1"
                                         BackgroundColor="#1C2B3A"/>

                                <!-- Phone -->
                                <VerticalStackLayout x:Name="PhoneColumn"
                                                     Grid.Column="2"
                                                     HorizontalOptions="Center"
                                                     Spacing="3" IsVisible="False">
                                    <Label Text="📞" FontSize="13"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="ProfilePhoneLabel"
                                           FontSize="11" TextColor="#64748B"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <!-- Member since (fallback when no phone) -->
                                <VerticalStackLayout x:Name="MemberColumn"
                                                     Grid.Column="2"
                                                     HorizontalOptions="Center"
                                                     Spacing="3" IsVisible="True">
                                    <Label Text="🗓" FontSize="13"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="MemberSinceShortLabel"
                                           FontSize="11" TextColor="#64748B"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Bio bubble -->
                            <Frame x:Name="BioBubble" IsVisible="False"
                                   BackgroundColor="#0F1923" CornerRadius="12"
                                   Padding="14,10" HasShadow="False"
                                   BorderColor="#1C2B3A">
                                <Label x:Name="ProfileBioLabel" Text=""
                                       FontSize="13" TextColor="#94A3B8"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"/>
                            </Frame>

                            <!-- Location + Member pills -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Frame x:Name="LocationPill" Grid.Column="0"
                                       BackgroundColor="#0F1923" CornerRadius="11"
                                       Padding="10,8" HasShadow="False"
                                       BorderColor="#1C2B3A" IsVisible="False">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="📍 LOCATION" FontSize="8"
                                               TextColor="#3B82F6"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"/>
                                        <Label x:Name="ProfileLocationLabel"
                                               FontSize="12" TextColor="#CBD5E1"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <Frame x:Name="MemberPill" Grid.Column="1"
                                       BackgroundColor="#0F1923" CornerRadius="11"
                                       Padding="10,8" HasShadow="False"
                                       BorderColor="#1C2B3A" IsVisible="False">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="🗓 MEMBER SINCE" FontSize="8"
                                               TextColor="#3B82F6"
                                               FontAttributes="Bold"
                                               CharacterSpacing="0.8"/>
                                        <Label x:Name="MemberSinceLabel"
                                               FontSize="12" TextColor="#CBD5E1"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- PERSONAL INFO CARD (all roles)                    -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="PersonalInfoCard"
                       CornerRadius="18" Padding="20,18"
                       HasShadow="False" BorderColor="#1C2B3A"
                       IsVisible="False"
                       BackgroundColor="#131F2E">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="PERSONAL INFO"
                               TextColor="#3B82F6" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1.8"/>

                        <!-- About / Bio -->
                        <VerticalStackLayout x:Name="PersonalBioSection"
                                             IsVisible="False" Spacing="5">
                            <Label Text="ABOUT ME" FontSize="8"
                                   TextColor="#334155" CharacterSpacing="1.2"/>
                            <Label x:Name="PersonalBioLabel" FontSize="13"
                                   TextColor="#94A3B8"
                                   LineBreakMode="WordWrap" LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Email row -->
                        <Grid x:Name="PersonalEmailRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="✉" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="#3B82F6"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="EMAIL" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="PersonalEmailLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Phone row -->
                        <Grid x:Name="PersonalPhoneRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="📞" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="PHONE" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="PersonalPhoneLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Date of Birth (staff/admin) -->
                        <Grid x:Name="DateOfBirthRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🎂" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="DATE OF BIRTH" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="DateOfBirthLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Emergency Contact (staff/admin) -->
                        <Grid x:Name="EmergencyContactRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🚨" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="EMERGENCY CONTACT" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="EmergencyContactLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Staff type (staff/admin) -->
                        <Grid x:Name="StaffTypeRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🏷" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="STAFF TYPE" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="StaffTypeLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Address -->
                        <Grid x:Name="AddressRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🏠" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="ADDRESS" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="AddressLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- City / Location -->
                        <Grid x:Name="CityCountryRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🌍" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="LOCATION" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="CityCountryLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Postal Code -->
                        <Grid x:Name="PostalCodeRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="📮" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="POSTAL CODE" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="PostalCodeLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Language & Timezone -->
                        <Grid x:Name="LanguageTimezoneRow"
                              ColumnDefinitions="*,*" ColumnSpacing="10"
                              IsVisible="False">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#0F1923" CornerRadius="11"
                                   Padding="12,8" HasShadow="False"
                                   BorderColor="#1C2B3A">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🌐 LANGUAGE" FontSize="8"
                                           TextColor="#3B82F6"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.8"/>
                                    <Label x:Name="LanguageLabel"
                                           FontSize="12" TextColor="#CBD5E1"/>
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1"
                                   BackgroundColor="#0F1923" CornerRadius="11"
                                   Padding="12,8" HasShadow="False"
                                   BorderColor="#1C2B3A">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="🕐 TIMEZONE" FontSize="8"
                                           TextColor="#3B82F6"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.8"/>
                                    <Label x:Name="TimezoneLabel"
                                           FontSize="12" TextColor="#CBD5E1"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Date joined -->
                        <Grid x:Name="DateJoinedRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="📅" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="MEMBER SINCE" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="DateJoinedLabel"
                                       FontSize="13" TextColor="#E2E8F0"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="NoPersonalInfoLabel"
                               Text="No personal information added yet."
                               FontSize="13" TextColor="#334155"
                               HorizontalOptions="Center"
                               IsVisible="False"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- ARTISAN STATS STRIP                                -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="ArtisanStatsCard"
                       CornerRadius="18" Padding="0"
                       HasShadow="False" BorderColor="#1C2B3A"
                       IsVisible="False"
                       BackgroundColor="#131F2E">
                    <VerticalStackLayout>
                        <BoxView HeightRequest="2">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#2563EB" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <Grid ColumnDefinitions="*,1,*,1,*,1,*"
                              Padding="0,18">

                            <!-- Rating -->
                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center" Spacing="3">
                                <Label x:Name="StatRatingLabel" Text="—"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="#3B82F6"
                                       HorizontalOptions="Center"/>
                                <Label Text="RATING" FontSize="8"
                                       TextColor="#334155"
                                       CharacterSpacing="1.2"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" WidthRequest="1"
                                     BackgroundColor="#1C2B3A"/>

                            <!-- Projects -->
                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center" Spacing="3">
                                <Label x:Name="StatProjectsLabel" Text="—"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="#3B82F6"
                                       HorizontalOptions="Center"/>
                                <Label Text="PROJECTS" FontSize="8"
                                       TextColor="#334155"
                                       CharacterSpacing="1.2"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="3" WidthRequest="1"
                                     BackgroundColor="#1C2B3A"/>

                            <!-- Reviews -->
                            <VerticalStackLayout Grid.Column="4"
                                                 HorizontalOptions="Center" Spacing="3">
                                <Label x:Name="StatReviewsLabel" Text="—"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="#3B82F6"
                                       HorizontalOptions="Center"/>
                                <Label Text="REVIEWS" FontSize="8"
                                       TextColor="#334155"
                                       CharacterSpacing="1.2"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="5" WidthRequest="1"
                                     BackgroundColor="#1C2B3A"/>

                            <!-- Experience -->
                            <VerticalStackLayout Grid.Column="6"
                                                 HorizontalOptions="Center" Spacing="3">
                                <Label x:Name="StatExperienceLabel" Text="—"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="#3B82F6"
                                       HorizontalOptions="Center"/>
                                <Label Text="YRS EXP" FontSize="8"
                                       TextColor="#334155"
                                       CharacterSpacing="1.2"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- ARTISAN BUSINESS CARD                              -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="ArtisanBusinessCard"
                       CornerRadius="18" Padding="20,18"
                       HasShadow="False" BorderColor="#1C2B3A"
                       IsVisible="False"
                       BackgroundColor="#131F2E">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="BUSINESS INFO"
                               TextColor="#3B82F6" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1.8"/>

                        <!-- Business name + specialization -->
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="BusinessNameLabel"
                                   FontSize="19" FontAttributes="Bold"
                                   TextColor="#FFFFFF"/>
                            <Label x:Name="SpecializationLabel"
                                   FontSize="13" TextColor="#64748B"/>
                        </VerticalStackLayout>

                        <!-- Artisan Speciality -->
                        <VerticalStackLayout x:Name="ArtisanSpecialityRow"
                                             IsVisible="False" Spacing="2">
                            <Label Text="SPECIALITY" FontSize="8"
                                   TextColor="#334155" CharacterSpacing="1.2"/>
                            <Label x:Name="ArtisanSpecialityLabel"
                                   FontSize="13" TextColor="#94A3B8"/>
                        </VerticalStackLayout>

                        <!-- Experience level -->
                        <VerticalStackLayout x:Name="ExperienceLevelRow"
                                             IsVisible="False" Spacing="2">
                            <Label Text="EXPERIENCE LEVEL" FontSize="8"
                                   TextColor="#334155" CharacterSpacing="1.2"/>
                            <Label x:Name="ExperienceLevelLabel"
                                   FontSize="13" TextColor="#94A3B8"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Rate + Radius -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Frame x:Name="HourlyRateBox" Grid.Column="0"
                                   BackgroundColor="#0F1923" CornerRadius="11"
                                   Padding="12,10" HasShadow="False"
                                   BorderColor="#1C2B3A" IsVisible="False">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="💰 RATE" FontSize="8"
                                           TextColor="#3B82F6"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.8"/>
                                    <Label x:Name="HourlyRateLabel"
                                           FontSize="14" TextColor="#E2E8F0"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame x:Name="ServiceRadiusBox" Grid.Column="1"
                                   BackgroundColor="#0F1923" CornerRadius="11"
                                   Padding="12,10" HasShadow="False"
                                   BorderColor="#1C2B3A" IsVisible="False">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="📍 RADIUS" FontSize="8"
                                           TextColor="#3B82F6"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.8"/>
                                    <Label x:Name="ServiceRadiusLabel"
                                           FontSize="14" TextColor="#E2E8F0"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Business Address -->
                        <Grid x:Name="BusinessAddressRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🏢" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="BUSINESS ADDRESS" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="BusinessAddressLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Availability -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame x:Name="AvailabilityBadge" Grid.Column="0"
                                   CornerRadius="9" Padding="12,5"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   BackgroundColor="#14532D">
                                <Label x:Name="AvailabilityLabel"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="White" CharacterSpacing="0.3"/>
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="Current availability"
                                   FontSize="11" TextColor="#334155"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#1C2B3A"/>

                        <!-- Slug -->
                        <VerticalStackLayout x:Name="SlugRow"
                                             IsVisible="False" Spacing="2">
                            <Label Text="PROFILE URL SLUG" FontSize="8"
                                   TextColor="#334155" CharacterSpacing="1.2"/>
                            <Label x:Name="SlugLabel"
                                   FontSize="13" TextColor="#3B82F6"/>
                        </VerticalStackLayout>

                        <!-- About -->
                        <VerticalStackLayout x:Name="AboutSection"
                                             Spacing="6" IsVisible="False">
                            <Label Text="ABOUT" FontSize="10"
                                   TextColor="#3B82F6" FontAttributes="Bold"
                                   CharacterSpacing="1.8"/>
                            <Label x:Name="AboutLabel" FontSize="13"
                                   TextColor="#94A3B8"
                                   LineBreakMode="WordWrap" LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Professional Bio -->
                        <VerticalStackLayout x:Name="ProfBioSection"
                                             Spacing="6" IsVisible="False">
                            <Label Text="PROFESSIONAL BIO" FontSize="10"
                                   TextColor="#3B82F6" FontAttributes="Bold"
                                   CharacterSpacing="1.8"/>
                            <Label x:Name="ProfBioLabel" FontSize="13"
                                   TextColor="#94A3B8"
                                   LineBreakMode="WordWrap" LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Services Offered -->
                        <VerticalStackLayout x:Name="ServicesSection"
                                             Spacing="8" IsVisible="False">
                            <Label Text="SERVICES OFFERED" FontSize="10"
                                   TextColor="#3B82F6" FontAttributes="Bold"
                                   CharacterSpacing="1.8"/>
                            <FlexLayout x:Name="ServicesLayout"
                                        Wrap="Wrap" Direction="Row"
                                        JustifyContent="Start"
                                        AlignItems="Start"/>
                        </VerticalStackLayout>

                        <!-- Last Updated -->
                        <VerticalStackLayout x:Name="UpdatedAtRow"
                                             IsVisible="False" Spacing="2">
                            <Label Text="LAST UPDATED" FontSize="8"
                                   TextColor="#334155" CharacterSpacing="1.2"/>
                            <Label x:Name="UpdatedAtLabel"
                                   FontSize="12" TextColor="#475569"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- ARTISAN CREDENTIALS CARD                           -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="CredentialsCard"
                       CornerRadius="18" Padding="20,18"
                       HasShadow="False" BorderColor="#1C2B3A"
                       IsVisible="False"
                       BackgroundColor="#131F2E">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="PROFESSIONAL CREDENTIALS"
                               TextColor="#3B82F6" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="1.8"/>

                        <!-- License -->
                        <Grid x:Name="LicenseRow"
                              ColumnDefinitions="34,*,Auto" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="📄" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="LICENSE NUMBER" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="LicenseLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Frame Grid.Column="2"
                                   BackgroundColor="#052E16" CornerRadius="7"
                                   Padding="7,3" HasShadow="False"
                                   VerticalOptions="Center"
                                   BorderColor="#16A34A">
                                <Label Text="LICENSED" FontSize="8"
                                       TextColor="#22C55E"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.5"/>
                            </Frame>
                        </Grid>

                        <!-- Certification -->
                        <Grid x:Name="CertificationRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🏅" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="CERTIFICATION" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="CertificationLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Business Registration -->
                        <Grid x:Name="BusinessRegRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="📋" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="BUSINESS REGISTRATION" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="BusinessRegLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Tax ID -->
                        <Grid x:Name="TaxIdRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🧾" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="TAX ID" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="TaxIdLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Insurance -->
                        <Grid x:Name="InsuranceRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="🛡" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="INSURANCE" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="InsuranceLabel"
                                       FontSize="13" TextColor="#E2E8F0"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Verified Date -->
                        <Grid x:Name="VerifiedDateRow"
                              ColumnDefinitions="34,*" ColumnSpacing="12"
                              IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1C2B3A"
                                   CornerRadius="9" Padding="0"
                                   HasShadow="False"
                                   WidthRequest="34" HeightRequest="34">
                                <Label Text="✅" FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="VERIFIED ON" FontSize="8"
                                       TextColor="#334155" CharacterSpacing="1"/>
                                <Label x:Name="VerifiedDateLabel"
                                       FontSize="13" TextColor="#22C55E"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="NoCredentialsLabel"
                               Text="No credentials added yet."
                               FontSize="13" TextColor="#334155"
                               HorizontalOptions="Center"
                               IsVisible="False"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Edit Profile Button ── -->
                <Frame x:Name="EditProfileButton" IsVisible="False"
                       CornerRadius="16" Padding="0" HasShadow="False"
                       HeightRequest="54" Margin="0,4,0,0"
                       BorderColor="Transparent">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1D4ED8" Offset="0"/>
                            <GradientStop Color="#2563EB" Offset="0.5"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Label Text="Edit Profile"
                           TextColor="#FFFFFF" FontSize="15"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           CharacterSpacing="0.3"/>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
