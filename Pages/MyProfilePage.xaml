<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.MyProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ── -->
        <Grid Grid.Row="0" BackgroundColor="#1B2B3A" Padding="16,52,16,16"
              ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0" Source="chevron_left.png"
                         WidthRequest="24" HeightRequest="24"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="My Profile"
                   TextColor="White" FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <ImageButton Grid.Column="2" Source="edit.png"
                         WidthRequest="22" HeightRequest="22"
                         BackgroundColor="Transparent"
                         Clicked="OnEditClicked"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#2E6FD8" HorizontalOptions="Center"
                                   Margin="0,40,0,0"/>

                <!-- ── Profile Hero Card ── -->
                <Frame x:Name="ProfileCard" BackgroundColor="White" CornerRadius="16"
                       Padding="24" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                        <!-- Avatar -->
                        <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                            <Frame x:Name="ProfileInitialsFrame"
                                   WidthRequest="96" HeightRequest="96" CornerRadius="48"
                                   Padding="0" HasShadow="False" IsClippedToBounds="True">
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4DA6E8" Offset="0"/>
                                        <GradientStop Color="#2E6FD8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <Label x:Name="ProfileInitialsLabel" Text="?"
                                       TextColor="White" FontSize="34" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Frame x:Name="ProfilePhotoFrame"
                                   WidthRequest="96" HeightRequest="96" CornerRadius="48"
                                   Padding="0" HasShadow="False" IsClippedToBounds="True"
                                   IsVisible="False">
                                <Image x:Name="ProfilePhoto" Aspect="AspectFill"
                                       WidthRequest="96" HeightRequest="96"/>
                            </Frame>
                        </Grid>

                        <!-- Name + role badge -->
                        <Label x:Name="ProfileNameLabel" Text="User"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="#1B2B3A" HorizontalOptions="Center"/>

                        <Frame x:Name="RoleBadgeFrame" CornerRadius="12" Padding="10,4"
                               HasShadow="False" HorizontalOptions="Center">
                            <Label x:Name="RoleBadgeLabel" FontSize="12" FontAttributes="Bold"
                                   TextColor="White"/>
                        </Frame>

                        <!-- Email & phone -->
                        <Label x:Name="ProfileEmailLabel" Text=""
                               FontSize="14" TextColor="#5A7184"
                               HorizontalOptions="Center"/>
                        <Label x:Name="ProfilePhoneLabel" Text=""
                               FontSize="14" TextColor="#5A7184"
                               HorizontalOptions="Center" IsVisible="False"/>

                        <!-- Bio -->
                        <Label x:Name="ProfileBioLabel" Text=""
                               FontSize="14" TextColor="#3D5166"
                               HorizontalOptions="Center" IsVisible="False"
                               LineBreakMode="WordWrap"/>

                        <!-- Location -->
                        <HorizontalStackLayout x:Name="LocationRow" HorizontalOptions="Center"
                                               Spacing="4" IsVisible="False">
                            <Image Source="location.png" WidthRequest="14" HeightRequest="14"
                                   VerticalOptions="Center"/>
                            <Label x:Name="ProfileLocationLabel" FontSize="13" TextColor="#5A7184"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Artisan Stats Card ── -->
                <Frame x:Name="ArtisanStatsCard" BackgroundColor="White" CornerRadius="16"
                       Padding="0" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <Grid ColumnDefinitions="*,1,*,1,*" Padding="0,16">
                        <!-- Rating -->
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="StatRatingLabel" Text="—" FontSize="20"
                                   FontAttributes="Bold" TextColor="#1B2B3A"
                                   HorizontalOptions="Center"/>
                            <Label Text="Rating" FontSize="11" TextColor="#8A9BAD"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#E8EDF2"/>
                        <!-- Projects -->
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="StatProjectsLabel" Text="—" FontSize="20"
                                   FontAttributes="Bold" TextColor="#1B2B3A"
                                   HorizontalOptions="Center"/>
                            <Label Text="Projects" FontSize="11" TextColor="#8A9BAD"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <BoxView Grid.Column="3" WidthRequest="1" BackgroundColor="#E8EDF2"/>
                        <!-- Experience -->
                        <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                            <Label x:Name="StatExperienceLabel" Text="—" FontSize="20"
                                   FontAttributes="Bold" TextColor="#1B2B3A"
                                   HorizontalOptions="Center"/>
                            <Label Text="Yrs Exp." FontSize="11" TextColor="#8A9BAD"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <!-- ── Artisan Business Card ── -->
                <Frame x:Name="ArtisanBusinessCard" BackgroundColor="White" CornerRadius="16"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="BUSINESS INFO" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <!-- Business name -->
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="briefcase.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label x:Name="BusinessNameLabel" Grid.Column="1"
                                   FontSize="15" FontAttributes="Bold" TextColor="#1B2B3A"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Specialization -->
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="tools.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label x:Name="SpecializationLabel" Grid.Column="1"
                                   FontSize="14" TextColor="#3D5166" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Hourly rate -->
                        <Grid x:Name="HourlyRateRow" ColumnDefinitions="20,*" ColumnSpacing="10"
                              IsVisible="False">
                            <Image Grid.Column="0" Source="card.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label x:Name="HourlyRateLabel" Grid.Column="1"
                                   FontSize="14" TextColor="#3D5166" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Availability -->
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="availability.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Frame x:Name="AvailabilityBadge" CornerRadius="8" Padding="8,3"
                                   HasShadow="False" HorizontalOptions="Start">
                                <Label x:Name="AvailabilityLabel" FontSize="12"
                                       FontAttributes="Bold" TextColor="White"/>
                            </Frame>
                        </Grid>

                        <!-- About -->
                        <VerticalStackLayout x:Name="AboutSection" Spacing="4" IsVisible="False">
                            <Label Text="About" FontSize="13" FontAttributes="Bold"
                                   TextColor="#8A9BAD"/>
                            <Label x:Name="AboutLabel" FontSize="14" TextColor="#3D5166"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Services -->
                        <VerticalStackLayout x:Name="ServicesSection" Spacing="6" IsVisible="False">
                            <Label Text="Services Offered" FontSize="13" FontAttributes="Bold"
                                   TextColor="#8A9BAD"/>
                            <FlexLayout x:Name="ServicesLayout" Wrap="Wrap" Direction="Row"
                                        JustifyContent="Start" AlignItems="Start"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Personal Info Card (Customer / Admin) ── -->
                <Frame x:Name="PersonalInfoCard" BackgroundColor="White" CornerRadius="16"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PERSONAL INFO" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <Grid x:Name="AddressRow" ColumnDefinitions="20,*" ColumnSpacing="10"
                              IsVisible="False">
                            <Image Grid.Column="0" Source="location.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Start"
                                   Margin="0,2,0,0"/>
                            <Label x:Name="AddressLabel" Grid.Column="1"
                                   FontSize="14" TextColor="#3D5166" LineBreakMode="WordWrap"/>
                        </Grid>

                        <Grid x:Name="CityCountryRow" ColumnDefinitions="20,*" ColumnSpacing="10"
                              IsVisible="False">
                            <Image Grid.Column="0" Source="globe.png"
                                   WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                            <Label x:Name="CityCountryLabel" Grid.Column="1"
                                   FontSize="14" TextColor="#3D5166" VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Edit Profile button -->
                <Button x:Name="EditProfileButton"
                        Text="Edit Profile"
                        BackgroundColor="#2E6FD8"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        IsVisible="False"
                        Clicked="OnEditClicked"
                        Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
