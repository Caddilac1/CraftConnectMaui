<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.MyProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1220">

    <Grid RowDefinitions="Auto,*">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- TOP BAR — deep navy with gold accent line                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" BackgroundColor="#0B1220" Padding="20,52,20,18"
              ColumnDefinitions="44,*,44">

            <Frame Grid.Column="0" BackgroundColor="#1A2740" CornerRadius="12"
                   Padding="0" HasShadow="False" WidthRequest="38" HeightRequest="38"
                   VerticalOptions="Center">
                <ImageButton Source="chevron_left.png"
                             WidthRequest="18" HeightRequest="18"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"
                             HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>

            <Label Grid.Column="1" Text="My Profile"
                   TextColor="#F0E6C8" FontSize="17" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   CharacterSpacing="0.5"/>

            <Frame Grid.Column="2" BackgroundColor="#1A2740" CornerRadius="12"
                   Padding="0" HasShadow="False" WidthRequest="38" HeightRequest="38"
                   VerticalOptions="Center">
                <ImageButton Source="edit.png"
                             WidthRequest="18" HeightRequest="18"
                             BackgroundColor="Transparent"
                             Clicked="OnEditClicked"
                             HorizontalOptions="Center" VerticalOptions="Center"/>
            </Frame>
        </Grid>

        <!-- Gold accent line under top bar -->
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                 Margin="20,0">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#C9A84C" Offset="0.4"/>
                    <GradientStop Color="#F0D080" Offset="0.6"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- SCROLLABLE BODY                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,20,16,40">

                <!-- ── Loading indicator ── -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#C9A84C" HorizontalOptions="Center"
                                   Margin="0,80,0,0"/>

                <!-- ── Error state ── -->
                <VerticalStackLayout x:Name="ErrorState" IsVisible="False"
                                     Spacing="14" HorizontalOptions="Center"
                                     Margin="0,80,0,0">
                    <Label Text="⚠" FontSize="52" HorizontalOptions="Center"
                           TextColor="#C9A84C"/>
                    <Label x:Name="ErrorLabel" Text="Could not load profile."
                           FontSize="15" TextColor="#7A8FA6"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Frame BackgroundColor="#1A2740" CornerRadius="14"
                           Padding="28,12" HasShadow="False"
                           HorizontalOptions="Center">
                        <Label Text="Try Again" TextColor="#C9A84C"
                               FontSize="14" FontAttributes="Bold"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRetryClicked"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>

                <!-- ════════════════════════════════════════════════ -->
                <!-- HERO CARD — premium dark glass with gold         -->
                <!-- ════════════════════════════════════════════════ -->
                <Frame x:Name="ProfileCard" CornerRadius="24" Padding="0"
                       HasShadow="False" BorderColor="#1E3050"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111D30" Offset="0"/>
                            <GradientStop Color="#162038" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>

                    <VerticalStackLayout Spacing="0">

                        <!-- Top gold shimmer line -->
                        <BoxView HeightRequest="2" CornerRadius="2,2,0,0">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#C9A84C" Offset="0.3"/>
                                    <GradientStop Color="#F0D080" Offset="0.5"/>
                                    <GradientStop Color="#C9A84C" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <VerticalStackLayout Spacing="14" Padding="28,28,28,28">

                            <!-- Avatar -->
                            <Grid WidthRequest="108" HeightRequest="108"
                                  HorizontalOptions="Center">

                                <!-- Outer gold ring -->
                                <Frame WidthRequest="108" HeightRequest="108"
                                       CornerRadius="54" Padding="3"
                                       HasShadow="False" IsClippedToBounds="True"
                                       BackgroundColor="Transparent">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#C9A84C" Offset="0"/>
                                            <GradientStop Color="#F0D080" Offset="0.5"/>
                                            <GradientStop Color="#9A7830" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Frame WidthRequest="100" HeightRequest="100"
                                           CornerRadius="50" Padding="0"
                                           HasShadow="False" IsClippedToBounds="True"
                                           BackgroundColor="#0B1220">
                                        <Label Text=" "/>
                                    </Frame>
                                </Frame>

                                <!-- Initials avatar -->
                                <Frame x:Name="ProfileInitialsFrame"
                                       WidthRequest="100" HeightRequest="100"
                                       CornerRadius="50" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E3254" Offset="0"/>
                                            <GradientStop Color="#0D1E38" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label x:Name="ProfileInitialsLabel" Text="?"
                                           FontSize="38" FontAttributes="Bold"
                                           TextColor="#C9A84C"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>

                                <!-- Photo avatar -->
                                <Frame x:Name="ProfilePhotoFrame"
                                       WidthRequest="100" HeightRequest="100"
                                       CornerRadius="50" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="False">
                                    <Image x:Name="ProfilePhoto" Aspect="AspectFill"
                                           WidthRequest="100" HeightRequest="100"/>
                                </Frame>

                                <!-- Verified badge -->
                                <Frame x:Name="VerifiedBadge"
                                       WidthRequest="30" HeightRequest="30"
                                       CornerRadius="15" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       HorizontalOptions="End" VerticalOptions="End"
                                       Margin="0,0,4,4"
                                       IsVisible="False">
                                    <Frame.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#22C55E" Offset="0"/>
                                            <GradientStop Color="#16A34A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Frame.Background>
                                    <Label Text="✓" TextColor="White" FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </Grid>

                            <!-- Full name -->
                            <Label x:Name="ProfileNameLabel" Text="User"
                                   FontSize="24" FontAttributes="Bold"
                                   TextColor="#F0E6C8"
                                   HorizontalOptions="Center"
                                   CharacterSpacing="0.3"/>

                            <!-- Role badge -->
                            <Frame x:Name="RoleBadgeFrame" CornerRadius="20"
                                   Padding="18,5" HasShadow="False"
                                   HorizontalOptions="Center"
                                   BorderColor="Transparent">
                                <Label x:Name="RoleBadgeLabel" FontSize="11"
                                       FontAttributes="Bold" TextColor="White"
                                       CharacterSpacing="1.5"/>
                            </Frame>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" Margin="0,4"
                                     BackgroundColor="#1E3050"/>

                            <!-- Contact info grid -->
                            <Grid ColumnDefinitions="*,1,*" RowDefinitions="Auto"
                                  ColumnSpacing="0">

                                <!-- Email -->
                                <VerticalStackLayout Grid.Column="0"
                                                     HorizontalOptions="Center"
                                                     Spacing="4">
                                    <Label Text="✉" FontSize="14"
                                           TextColor="#C9A84C"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="ProfileEmailLabel" Text=""
                                           FontSize="11" TextColor="#7A8FA6"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="MiddleTruncation"/>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1"
                                         BackgroundColor="#1E3050"/>

                                <!-- Phone -->
                                <VerticalStackLayout x:Name="PhoneColumn"
                                                     Grid.Column="2"
                                                     HorizontalOptions="Center"
                                                     Spacing="4" IsVisible="False">
                                    <Label Text="📞" FontSize="14"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="ProfilePhoneLabel" FontSize="11"
                                           TextColor="#7A8FA6"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <!-- Member since (when no phone) -->
                                <VerticalStackLayout x:Name="MemberColumn"
                                                     Grid.Column="2"
                                                     HorizontalOptions="Center"
                                                     Spacing="4" IsVisible="True">
                                    <Label Text="🗓" FontSize="14"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="MemberSinceShortLabel"
                                           FontSize="11" TextColor="#7A8FA6"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Bio -->
                            <Frame x:Name="BioBubble" IsVisible="False"
                                   BackgroundColor="#0D1E38" CornerRadius="14"
                                   Padding="16,10" HasShadow="False"
                                   BorderColor="#1E3050">
                                <Label x:Name="ProfileBioLabel" Text=""
                                       FontSize="13" TextColor="#A8BECE"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"/>
                            </Frame>

                            <!-- Location + Member since row -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Frame x:Name="LocationPill" Grid.Column="0"
                                       BackgroundColor="#0D1E38" CornerRadius="12"
                                       Padding="10,8" HasShadow="False"
                                       BorderColor="#1E3050" IsVisible="False">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="📍 LOCATION" FontSize="9"
                                               TextColor="#C9A84C"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"/>
                                        <Label x:Name="ProfileLocationLabel"
                                               FontSize="12" TextColor="#A8BECE"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <Frame x:Name="MemberPill" Grid.Column="1"
                                       BackgroundColor="#0D1E38" CornerRadius="12"
                                       Padding="10,8" HasShadow="False"
                                       BorderColor="#1E3050" IsVisible="False">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="🗓 MEMBER SINCE" FontSize="9"
                                               TextColor="#C9A84C"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"/>
                                        <Label x:Name="MemberSinceLabel"
                                               FontSize="12" TextColor="#A8BECE"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- ════════════════════════════════════════════════ -->
                <!-- ARTISAN — STATS STRIP                            -->
                <!-- ════════════════════════════════════════════════ -->
                <Frame x:Name="ArtisanStatsCard" CornerRadius="20" Padding="0"
                       HasShadow="False" BorderColor="#1E3050"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111D30" Offset="0"/>
                            <GradientStop Color="#162038" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <VerticalStackLayout>
                        <BoxView HeightRequest="2">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#C9A84C" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>
                        <Grid ColumnDefinitions="*,1,*,1,*" Padding="0,20">

                            <VerticalStackLayout Grid.Column="0"
                                                 HorizontalOptions="Center"
                                                 Spacing="4">
                                <Label x:Name="StatRatingLabel" Text="—"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#C9A84C"
                                       HorizontalOptions="Center"/>
                                <Label Text="RATING" FontSize="9"
                                       TextColor="#4A6080"
                                       CharacterSpacing="1.5"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" WidthRequest="1"
                                     BackgroundColor="#1E3050"/>

                            <VerticalStackLayout Grid.Column="2"
                                                 HorizontalOptions="Center"
                                                 Spacing="4">
                                <Label x:Name="StatProjectsLabel" Text="—"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#C9A84C"
                                       HorizontalOptions="Center"/>
                                <Label Text="PROJECTS" FontSize="9"
                                       TextColor="#4A6080"
                                       CharacterSpacing="1.5"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="3" WidthRequest="1"
                                     BackgroundColor="#1E3050"/>

                            <VerticalStackLayout Grid.Column="4"
                                                 HorizontalOptions="Center"
                                                 Spacing="4">
                                <Label x:Name="StatExperienceLabel" Text="—"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#C9A84C"
                                       HorizontalOptions="Center"/>
                                <Label Text="YRS EXP" FontSize="9"
                                       TextColor="#4A6080"
                                       CharacterSpacing="1.5"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- ════════════════════════════════════════════════ -->
                <!-- ARTISAN — BUSINESS INFO CARD                     -->
                <!-- ════════════════════════════════════════════════ -->
                <Frame x:Name="ArtisanBusinessCard" CornerRadius="20"
                       Padding="22,20" HasShadow="False" BorderColor="#1E3050"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111D30" Offset="0"/>
                            <GradientStop Color="#162038" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <VerticalStackLayout Spacing="16">

                        <Label Text="BUSINESS INFO" TextColor="#C9A84C"
                               FontSize="10" FontAttributes="Bold"
                               CharacterSpacing="2"/>

                        <!-- Business name + specialization -->
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="BusinessNameLabel"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="#F0E6C8"/>
                            <Label x:Name="SpecializationLabel"
                                   FontSize="13" TextColor="#7A8FA6"/>
                        </VerticalStackLayout>

                        <!-- Artisan Speciality -->
                        <VerticalStackLayout x:Name="ArtisanSpecialityRow"
                                             IsVisible="False" Spacing="2">
                            <Label Text="SPECIALITY" FontSize="9"
                                   TextColor="#4A6080" CharacterSpacing="1.2"/>
                            <Label x:Name="ArtisanSpecialityLabel"
                                   FontSize="13" TextColor="#A8BECE"/>
                        </VerticalStackLayout>

                        <!-- Rate + Radius row -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Frame x:Name="HourlyRateBox" Grid.Column="0"
                                   BackgroundColor="#0D1E38" CornerRadius="14"
                                   Padding="14,10" HasShadow="False"
                                   BorderColor="#1E3050" IsVisible="False">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="💰 RATE" FontSize="9"
                                           TextColor="#C9A84C"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"/>
                                    <Label x:Name="HourlyRateLabel"
                                           FontSize="14" TextColor="#F0E6C8"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame x:Name="ServiceRadiusBox" Grid.Column="1"
                                   BackgroundColor="#0D1E38" CornerRadius="14"
                                   Padding="14,10" HasShadow="False"
                                   BorderColor="#1E3050" IsVisible="False">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="📍 RADIUS" FontSize="9"
                                           TextColor="#C9A84C"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"/>
                                    <Label x:Name="ServiceRadiusLabel"
                                           FontSize="14" TextColor="#F0E6C8"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <!-- Business Address -->
                        <VerticalStackLayout x:Name="BusinessAddressRow"
                                             IsVisible="False" Spacing="3">
                            <Label Text="🏠 ADDRESS" FontSize="9"
                                   TextColor="#4A6080" CharacterSpacing="1.2"/>
                            <Label x:Name="BusinessAddressLabel"
                                   FontSize="13" TextColor="#A8BECE"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Availability -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame x:Name="AvailabilityBadge" Grid.Column="0"
                                   CornerRadius="10" Padding="14,6"
                                   HasShadow="False" VerticalOptions="Center">
                                <Label x:Name="AvailabilityLabel" FontSize="11"
                                       FontAttributes="Bold" TextColor="White"
                                       CharacterSpacing="0.5"/>
                            </Frame>
                            <Label Grid.Column="1"
                                   Text="Current availability status"
                                   FontSize="11" TextColor="#4A6080"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#1E3050"/>

                        <!-- About -->
                        <VerticalStackLayout x:Name="AboutSection"
                                             Spacing="8" IsVisible="False">
                            <Label Text="ABOUT" FontSize="10"
                                   TextColor="#C9A84C" FontAttributes="Bold"
                                   CharacterSpacing="2"/>
                            <Label x:Name="AboutLabel" FontSize="13"
                                   TextColor="#A8BECE"
                                   LineBreakMode="WordWrap"
                                   LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Professional Bio -->
                        <VerticalStackLayout x:Name="ProfBioSection"
                                             Spacing="8" IsVisible="False">
                            <Label Text="PROFESSIONAL BIO" FontSize="10"
                                   TextColor="#C9A84C" FontAttributes="Bold"
                                   CharacterSpacing="2"/>
                            <Label x:Name="ProfBioLabel" FontSize="13"
                                   TextColor="#A8BECE"
                                   LineBreakMode="WordWrap"
                                   LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Services Offered -->
                        <VerticalStackLayout x:Name="ServicesSection"
                                             Spacing="10" IsVisible="False">
                            <Label Text="SERVICES OFFERED" FontSize="10"
                                   TextColor="#C9A84C" FontAttributes="Bold"
                                   CharacterSpacing="2"/>
                            <FlexLayout x:Name="ServicesLayout"
                                        Wrap="Wrap" Direction="Row"
                                        JustifyContent="Start"
                                        AlignItems="Start"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ════════════════════════════════════════════════ -->
                <!-- ARTISAN — CREDENTIALS CARD                       -->
                <!-- ════════════════════════════════════════════════ -->
                <Frame x:Name="CredentialsCard" CornerRadius="20"
                       Padding="22,20" HasShadow="False" BorderColor="#1E3050"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111D30" Offset="0"/>
                            <GradientStop Color="#162038" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <VerticalStackLayout Spacing="16">

                        <Label Text="PROFESSIONAL CREDENTIALS"
                               TextColor="#C9A84C" FontSize="10"
                               FontAttributes="Bold" CharacterSpacing="2"/>

                        <!-- License -->
                        <Grid x:Name="LicenseRow" ColumnDefinitions="36,*,Auto"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="📄" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="LICENSE NUMBER" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="LicenseLabel" FontSize="14"
                                       TextColor="#F0E6C8" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Frame Grid.Column="2" BackgroundColor="#0D2A1A"
                                   CornerRadius="8" Padding="8,4"
                                   HasShadow="False" VerticalOptions="Center"
                                   BorderColor="#16A34A">
                                <Label Text="LICENSED" FontSize="9"
                                       TextColor="#22C55E"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                            </Frame>
                        </Grid>

                        <!-- Certification -->
                        <Grid x:Name="CertificationRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="🏅" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="CERTIFICATION" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="CertificationLabel"
                                       FontSize="14" TextColor="#F0E6C8"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Business Registration -->
                        <Grid x:Name="BusinessRegRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="📋" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="BUSINESS REGISTRATION" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="BusinessRegLabel" FontSize="14"
                                       TextColor="#F0E6C8" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Tax ID -->
                        <Grid x:Name="TaxIdRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="🧾" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="TAX ID" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="TaxIdLabel" FontSize="14"
                                       TextColor="#F0E6C8" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Insurance -->
                        <Grid x:Name="InsuranceRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="🛡" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="INSURANCE" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="InsuranceLabel" FontSize="14"
                                       TextColor="#F0E6C8" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="NoCredentialsLabel"
                               Text="No credentials added yet."
                               FontSize="13" TextColor="#4A6080"
                               HorizontalOptions="Center"
                               IsVisible="False"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ════════════════════════════════════════════════ -->
                <!-- CUSTOMER / ADMIN / STAFF — PERSONAL INFO CARD    -->
                <!-- ════════════════════════════════════════════════ -->
                <Frame x:Name="PersonalInfoCard" CornerRadius="20"
                       Padding="22,20" HasShadow="False" BorderColor="#1E3050"
                       IsVisible="False">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#111D30" Offset="0"/>
                            <GradientStop Color="#162038" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <VerticalStackLayout Spacing="16">

                        <Label Text="PERSONAL INFO" TextColor="#C9A84C"
                               FontSize="10" FontAttributes="Bold"
                               CharacterSpacing="2"/>

                        <!-- Bio -->
                        <VerticalStackLayout x:Name="PersonalBioSection"
                                             Spacing="6" IsVisible="False">
                            <Label Text="ABOUT ME" FontSize="9"
                                   TextColor="#4A6080" CharacterSpacing="1.2"/>
                            <Label x:Name="PersonalBioLabel" FontSize="13"
                                   TextColor="#A8BECE"
                                   LineBreakMode="WordWrap"
                                   LineHeight="1.5"/>
                        </VerticalStackLayout>

                        <!-- Address -->
                        <Grid x:Name="AddressRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="🏠" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="ADDRESS" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="AddressLabel" FontSize="14"
                                       TextColor="#F0E6C8"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- City / Location -->
                        <Grid x:Name="CityCountryRow" ColumnDefinitions="36,*"
                              ColumnSpacing="10" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#1A2A42"
                                   CornerRadius="10" Padding="0"
                                   HasShadow="False" WidthRequest="36"
                                   HeightRequest="36">
                                <Label Text="🌍" FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="LOCATION" FontSize="9"
                                       TextColor="#4A6080" CharacterSpacing="1"/>
                                <Label x:Name="CityCountryLabel" FontSize="14"
                                       TextColor="#F0E6C8"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="NoAddressLabel"
                               Text="No address added yet. Tap Edit to update."
                               FontSize="13" TextColor="#4A6080"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               IsVisible="False"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ── Edit Profile CTA — gold gradient button ── -->
                <Frame x:Name="EditProfileButton" IsVisible="False"
                       CornerRadius="18" Padding="0" HasShadow="False"
                       HeightRequest="58" Margin="0,6,0,0"
                       BorderColor="Transparent">
                    <Frame.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#9A7830" Offset="0"/>
                            <GradientStop Color="#C9A84C" Offset="0.4"/>
                            <GradientStop Color="#F0D080" Offset="0.6"/>
                            <GradientStop Color="#C9A84C" Offset="1"/>
                        </LinearGradientBrush>
                    </Frame.Background>
                    <Label Text="Edit Profile"
                           TextColor="#0B1220" FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           CharacterSpacing="0.5"/>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped"/>
                    </Frame.GestureRecognizers>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
