<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.MyProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EFF3F8">

    <Grid RowDefinitions="Auto,*">

        <!-- ═══════════════════════════════════════════════ -->
        <!-- DARK NAVY HEADER                                -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="#1B2D3E"
              RowDefinitions="Auto,Auto,Auto"
              RowSpacing="0">

            <!-- Top bar: back + title + edit -->
            <Grid Grid.Row="0"
                  Padding="16,52,16,16"
                  ColumnDefinitions="40,*,40">

                <Frame Grid.Column="0"
                       BackgroundColor="#243B52" CornerRadius="12"
                       Padding="0" HasShadow="False"
                       WidthRequest="40" HeightRequest="40"
                       VerticalOptions="Center">
                    <ImageButton Source="chevron_left.svg"
                                 WidthRequest="16" HeightRequest="16"
                                 BackgroundColor="Transparent"
                                 Clicked="OnBackClicked"
                                 HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>

                <Label Grid.Column="1" Text="My Profile"
                       TextColor="#FFFFFF" FontSize="17" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       CharacterSpacing="0.3"/>

                <Frame Grid.Column="2"
                       BackgroundColor="#243B52" CornerRadius="12"
                       Padding="0" HasShadow="False"
                       WidthRequest="40" HeightRequest="40"
                       VerticalOptions="Center">
                    <ImageButton Source="edit.svg"
                                 WidthRequest="16" HeightRequest="16"
                                 BackgroundColor="Transparent"
                                 Clicked="OnEditClicked"
                                 HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
            </Grid>

            <!-- Profile row: centered avatar with name and email below -->
            <VerticalStackLayout Grid.Row="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12"
                                 Margin="0,0,0,20">

                <!-- Avatar stack - centered -->
                <Grid WidthRequest="80" HeightRequest="80"
                      HorizontalOptions="Center">

                    <Frame x:Name="ProfileInitialsFrame"
                           WidthRequest="80" HeightRequest="80"
                           CornerRadius="40" Padding="0"
                           HasShadow="False" IsClippedToBounds="True"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           BackgroundColor="#2E4D6A">
                        <Label x:Name="ProfileInitialsLabel" Text="?"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Frame x:Name="ProfilePhotoFrame"
                           WidthRequest="80" HeightRequest="80"
                           CornerRadius="40" Padding="0"
                           HasShadow="False" IsClippedToBounds="True"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           IsVisible="False">
                        <Image x:Name="ProfilePhoto"
                               Aspect="AspectFill"
                               WidthRequest="80" HeightRequest="80"/>
                    </Frame>

                    <Frame x:Name="VerifiedBadge"
                           WidthRequest="24" HeightRequest="24"
                           CornerRadius="12" Padding="0"
                           HasShadow="False" IsClippedToBounds="True"
                           HorizontalOptions="End" VerticalOptions="End"
                           Margin="0,0,2,2"
                           IsVisible="False"
                           BackgroundColor="#1D9E75">
                        <Image Source="shield_check.svg"
                               WidthRequest="14" HeightRequest="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                </Grid>

                <!-- Name / email / role badge - centered -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center" 
                                     Spacing="4">
                    <Label x:Name="ProfileNameLabel" Text="User"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center"
                           LineBreakMode="TailTruncation"/>

                    <Label x:Name="ProfileEmailLabel" Text=""
                           FontSize="13" TextColor="#8BAFC9"
                           HorizontalOptions="Center"
                           LineBreakMode="TailTruncation"/>

                    <Frame x:Name="RoleBadgeFrame"
                           CornerRadius="20" Padding="10,4"
                           HasShadow="False"
                           HorizontalOptions="Center"
                           Margin="0,2,0,0"
                           BackgroundColor="#243B52"
                           BorderColor="#3A5A78">
                        <Label x:Name="RoleBadgeLabel"
                               FontSize="10" FontAttributes="Bold"
                               TextColor="#7DB8E0"
                               CharacterSpacing="0.6"/>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Stats strip -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,1,*,1,*,1,*"
                  Margin="16,0,16,0"
                  BackgroundColor="#243B52"
                  HeightRequest="64">

                <Frame Grid.Column="0" Grid.ColumnSpan="7"
                       CornerRadius="16" Padding="0"
                       HasShadow="False" BackgroundColor="#243B52"
                       BorderColor="#2E4D6A"
                       Margin="0,0,0,20"/>

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="3">
                    <Label x:Name="StatRatingLabel" Text="—"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="Rating" FontSize="9" TextColor="#8BAFC9"
                           HorizontalOptions="Center" CharacterSpacing="0.4"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="1" WidthRequest="1"
                         BackgroundColor="#2E4D6A" VerticalOptions="Fill"
                         Margin="0,12"/>

                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="3">
                    <Label x:Name="StatProjectsLabel" Text="—"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="Projects" FontSize="9" TextColor="#8BAFC9"
                           HorizontalOptions="Center" CharacterSpacing="0.4"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="3" WidthRequest="1"
                         BackgroundColor="#2E4D6A" VerticalOptions="Fill"
                         Margin="0,12"/>

                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="3">
                    <Label x:Name="StatReviewsLabel" Text="—"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="Reviews" FontSize="9" TextColor="#8BAFC9"
                           HorizontalOptions="Center" CharacterSpacing="0.4"/>
                </VerticalStackLayout>

                <BoxView Grid.Column="5" WidthRequest="1"
                         BackgroundColor="#2E4D6A" VerticalOptions="Fill"
                         Margin="0,12"/>

                <VerticalStackLayout Grid.Column="6" HorizontalOptions="Center"
                                     VerticalOptions="Center" Spacing="3">
                    <Label x:Name="StatExperienceLabel" Text="—"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="Exp." FontSize="9" TextColor="#8BAFC9"
                           HorizontalOptions="Center" CharacterSpacing="0.4"/>
                </VerticalStackLayout>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- SCROLLABLE BODY                                 -->
        <!-- ═══════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10" Padding="16,16,16,48">

                <!-- Loading -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#2563EB"
                                   HorizontalOptions="Center"
                                   Margin="0,60,0,0"/>

                <!-- Error state -->
                <VerticalStackLayout x:Name="ErrorState" IsVisible="False"
                                     Spacing="14" HorizontalOptions="Center"
                                     Margin="0,60,0,0">
                    <Image Source="info.svg"
                           WidthRequest="40" HeightRequest="40"
                           HorizontalOptions="Center"/>
                    <Label x:Name="ErrorLabel" Text="Could not load profile."
                           FontSize="14" TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                    <Frame BackgroundColor="White" CornerRadius="12"
                           Padding="24,10" HasShadow="False"
                           HorizontalOptions="Center"
                           BorderColor="#BFDBFE">
                        <Label Text="Try again" TextColor="#2563EB"
                               FontSize="14" FontAttributes="Bold"/>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRetryClicked"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </VerticalStackLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- TRUST SCORE CARD                        -->
                <!-- ═══════════════════════════════════════ -->
                <Frame x:Name="TrustScoreCard"
                       CornerRadius="20" Padding="0"
                       HasShadow="False"
                       BorderColor="Transparent"
                       IsVisible="False"
                       BackgroundColor="#1B2D3E">
                    <VerticalStackLayout Spacing="0">

                        <!-- Score hero section -->
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="20,20,20,16">

                            <!-- Left: label + score number + band -->
                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center" Spacing="4">
                                <Label Text="TRUST SCORE"
                                       FontSize="9" FontAttributes="Bold"
                                       TextColor="#8BAFC9" CharacterSpacing="1.4"/>

                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10"
                                      VerticalOptions="Center">
                                    <Label x:Name="TrustScoreValueLabel" Text="—"
                                           Grid.Column="0"
                                           FontSize="52" FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           LineHeight="1"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="End"
                                                         Spacing="3" Margin="0,0,0,6">
                                        <Label Text="/ 1000" FontSize="14"
                                               TextColor="#8BAFC9"/>
                                        <!-- Band pill -->
                                        <Frame x:Name="TrustBandPill"
                                               CornerRadius="20" Padding="10,4"
                                               HasShadow="False"
                                               BackgroundColor="#F59E0B"
                                               BorderColor="Transparent">
                                            <Label x:Name="TrustBandLabel" Text="—"
                                                   FontSize="10" FontAttributes="Bold"
                                                   TextColor="#1B2D3E"
                                                   CharacterSpacing="0.6"/>
                                        </Frame>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label x:Name="TrustCalcLabel"
                                       Text="Calculated —"
                                       FontSize="11" TextColor="#4A7A9B"
                                       Margin="0,2,0,0"/>
                            </VerticalStackLayout>

                            <!-- Right: score ring visual -->
                            <Grid Grid.Column="1"
                                  WidthRequest="80" HeightRequest="80"
                                  VerticalOptions="Center">
                                <!-- Outer ring track -->
                                <Frame WidthRequest="80" HeightRequest="80"
                                       CornerRadius="40" Padding="0"
                                       HasShadow="False" IsClippedToBounds="True"
                                       BackgroundColor="#243B52"
                                       BorderColor="#2E4D6A"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <!-- Inner circle -->
                                <Frame WidthRequest="56" HeightRequest="56"
                                       CornerRadius="28" Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="#1B2D3E"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <!-- Score indicator icon -->
                                <Image x:Name="TrustBandIcon"
                                       Source="shield_check.svg"
                                       WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Score breakdown mini-bar -->
                        <BoxView HeightRequest="0.5" Color="#243B52"/>
                        <StackLayout x:Name="TrustBreakdownSection"
                                     IsVisible="False"
                                     Padding="20,14,20,14" Spacing="10">
                            <Label Text="SCORE BREAKDOWN"
                                   FontSize="8" FontAttributes="Bold"
                                   TextColor="#4A7A9B" CharacterSpacing="1.2"/>
                            <!-- Breakdown items injected in code-behind -->
                            <VerticalStackLayout x:Name="TrustBreakdownLayout"
                                                 Spacing="8"/>
                        </StackLayout>

                        <!-- ─── Referrals summary strip ─── -->
                        <BoxView HeightRequest="0.5" Color="#243B52"/>
                        <Grid ColumnDefinitions="*,1,*,1,*"
                              Padding="0,0,0,0"
                              x:Name="ReferralSummaryStrip"
                              IsVisible="False">

                            <!-- Work referrals -->
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="2" Padding="0,14"
                                                 HorizontalOptions="Center">
                                <Label x:Name="WorkReferralCountLabel" Text="—"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="#FFFFFF" HorizontalOptions="Center"/>
                                <Label Text="Work" FontSize="9"
                                       TextColor="#4A7A9B"
                                       HorizontalOptions="Center" CharacterSpacing="0.4"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1" WidthRequest="0.5"
                                     BackgroundColor="#243B52" VerticalOptions="Fill"
                                     Margin="0,10"/>

                            <!-- Vendor referrals -->
                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="2" Padding="0,14"
                                                 HorizontalOptions="Center">
                                <Label x:Name="VendorReferralCountLabel" Text="—"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="#FFFFFF" HorizontalOptions="Center"/>
                                <Label Text="Vendor" FontSize="9"
                                       TextColor="#4A7A9B"
                                       HorizontalOptions="Center" CharacterSpacing="0.4"/>
                            </VerticalStackLayout>

                            <BoxView Grid.Column="3" WidthRequest="0.5"
                                     BackgroundColor="#243B52" VerticalOptions="Fill"
                                     Margin="0,10"/>

                            <!-- Colleague referrals -->
                            <VerticalStackLayout Grid.Column="4"
                                                 Spacing="2" Padding="0,14"
                                                 HorizontalOptions="Center">
                                <Label x:Name="ColleagueReferralCountLabel" Text="—"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="#FFFFFF" HorizontalOptions="Center"/>
                                <Label Text="Colleague" FontSize="9"
                                       TextColor="#4A7A9B"
                                       HorizontalOptions="Center" CharacterSpacing="0.4"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- ─── History accordion toggle ─── -->
                        <BoxView HeightRequest="0.5" Color="#243B52"/>
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="20,14"
                              x:Name="TrustHistoryToggle">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrustHistoryToggled"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="Score History"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#7DB8E0"
                                   VerticalOptions="Center"/>
                            <Image x:Name="HistoryChevron"
                                   Grid.Column="1"
                                   Source="chevron_down.svg"
                                   WidthRequest="14" HeightRequest="14"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- History list (collapsed by default) -->
                        <VerticalStackLayout x:Name="TrustHistoryPanel"
                                             IsVisible="False"
                                             Spacing="0">
                            <BoxView HeightRequest="0.5" Color="#243B52"/>
                            <VerticalStackLayout x:Name="TrustHistoryLayout"
                                                 Spacing="0"
                                                 Padding="20,10,20,6"/>
                            <Label x:Name="NoHistoryLabel"
                                   Text="No history available yet."
                                   FontSize="12" TextColor="#4A7A9B"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,12"/>
                        </VerticalStackLayout>

                        <!-- ─── Referral details accordion toggle ─── -->
                        <BoxView HeightRequest="0.5" Color="#243B52"/>
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="20,14"
                              x:Name="ReferralDetailsToggle">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnReferralDetailsToggled"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="Referral Details"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#7DB8E0"
                                   VerticalOptions="Center"/>
                            <Image x:Name="ReferralChevron"
                                   Grid.Column="1"
                                   Source="chevron_down.svg"
                                   WidthRequest="14" HeightRequest="14"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Referral details panel (collapsed) -->
                        <VerticalStackLayout x:Name="ReferralDetailsPanel"
                                             IsVisible="False"
                                             Spacing="0">
                            <BoxView HeightRequest="0.5" Color="#243B52"/>

                            <!-- Work referrals sub-section -->
                            <VerticalStackLayout x:Name="WorkReferralSection"
                                                 IsVisible="False"
                                                 Spacing="0" Padding="20,14,20,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                      Margin="0,0,0,10">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#243B52" CornerRadius="8"
                                           Padding="7,4" HasShadow="False">
                                        <Label Text="WORK" FontSize="8"
                                               TextColor="#7DB8E0" FontAttributes="Bold"
                                               CharacterSpacing="0.8"/>
                                    </Frame>
                                    <BoxView Grid.Column="1" HeightRequest="0.5"
                                             BackgroundColor="#243B52"
                                             VerticalOptions="Center"/>
                                </Grid>
                                <VerticalStackLayout x:Name="WorkReferralLayout"
                                                     Spacing="10"/>
                            </VerticalStackLayout>

                            <!-- Vendor referrals sub-section -->
                            <VerticalStackLayout x:Name="VendorReferralSection"
                                                 IsVisible="False"
                                                 Spacing="0" Padding="20,14,20,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                      Margin="0,0,0,10">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#243B52" CornerRadius="8"
                                           Padding="7,4" HasShadow="False">
                                        <Label Text="VENDOR" FontSize="8"
                                               TextColor="#7DB8E0" FontAttributes="Bold"
                                               CharacterSpacing="0.8"/>
                                    </Frame>
                                    <BoxView Grid.Column="1" HeightRequest="0.5"
                                             BackgroundColor="#243B52"
                                             VerticalOptions="Center"/>
                                </Grid>
                                <VerticalStackLayout x:Name="VendorReferralLayout"
                                                     Spacing="10"/>
                            </VerticalStackLayout>

                            <!-- Colleague referrals sub-section -->
                            <VerticalStackLayout x:Name="ColleagueReferralSection"
                                                 IsVisible="False"
                                                 Spacing="0" Padding="20,14,20,14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                      Margin="0,0,0,10">
                                    <Frame Grid.Column="0"
                                           BackgroundColor="#243B52" CornerRadius="8"
                                           Padding="7,4" HasShadow="False">
                                        <Label Text="COLLEAGUE" FontSize="8"
                                               TextColor="#7DB8E0" FontAttributes="Bold"
                                               CharacterSpacing="0.8"/>
                                    </Frame>
                                    <BoxView Grid.Column="1" HeightRequest="0.5"
                                             BackgroundColor="#243B52"
                                             VerticalOptions="Center"/>
                                </Grid>
                                <VerticalStackLayout x:Name="ColleagueReferralLayout"
                                                     Spacing="10"/>
                            </VerticalStackLayout>

                            <Label x:Name="NoReferralsLabel"
                                   Text="No referrals found."
                                   FontSize="12" TextColor="#4A7A9B"
                                   IsVisible="False"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,16"/>
                        </VerticalStackLayout>

                        <!-- Trust score loading / error states -->
                        <ActivityIndicator x:Name="TrustScoreLoading"
                                           IsRunning="True" IsVisible="False"
                                           Color="#7DB8E0"
                                           HorizontalOptions="Center"
                                           Margin="0,10,0,14"/>
                        <Label x:Name="TrustScoreErrorLabel"
                               IsVisible="False"
                               FontSize="12" TextColor="#DC2626"
                               HorizontalOptions="Center"
                               Margin="0,0,0,14"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Frame>

                <!-- ─────────────────────── -->
                <!-- BIO CARD                -->
                <!-- ─────────────────────── -->
                <Frame x:Name="BioCard"
                       CornerRadius="16" Padding="16,14"
                       HasShadow="False" BorderColor="#E2E8F0"
                       IsVisible="False"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ABOUT" FontSize="9" TextColor="#8BAFC9"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>
                        <Label x:Name="BioLabel" FontSize="13"
                               TextColor="#1B2D3E"
                               LineBreakMode="WordWrap" LineHeight="1.6"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ─────────────────────── -->
                <!-- BUSINESS CARD           -->
                <!-- ─────────────────────── -->
                <Frame x:Name="ArtisanBusinessCard"
                       CornerRadius="16" Padding="0"
                       HasShadow="False" BorderColor="#E2E8F0"
                       IsVisible="False"
                       BackgroundColor="White">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              Padding="16,14,16,10">
                            <Image Grid.Column="0" Source="briefcase.svg"
                                   WidthRequest="14" HeightRequest="14"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="BUSINESS"
                                   TextColor="#8BAFC9" FontSize="10"
                                   FontAttributes="Bold" CharacterSpacing="1.2"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="0.5" Color="#EFF3F8"/>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              Padding="16,13">
                            <Frame Grid.Column="0" BackgroundColor="#EBF3FB"
                                   CornerRadius="12" Padding="0" HasShadow="False"
                                   WidthRequest="38" HeightRequest="38">
                                <Image Source="briefcase.svg"
                                       WidthRequest="18" HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="BUSINESS NAME" FontSize="8"
                                       TextColor="#8BAFC9" CharacterSpacing="0.8"/>
                                <Label x:Name="BusinessNameLabel"
                                       FontSize="14" TextColor="#1B2D3E"
                                       FontAttributes="Bold"/>
                                <Label x:Name="SpecializationLabel"
                                       FontSize="12" TextColor="#8BAFC9"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="0.5" Color="#EFF3F8"/>

                        <Grid x:Name="ArtisanSpecialityRow"
                              ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              Padding="16,13" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#EBF3FB" CornerRadius="12"
                                   Padding="0" HasShadow="False"
                                   WidthRequest="38" HeightRequest="38">
                                <Image Source="availability.svg"
                                       WidthRequest="18" HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="SPECIALITY" FontSize="8"
                                       TextColor="#8BAFC9" CharacterSpacing="0.8"/>
                                <Label x:Name="ArtisanSpecialityLabel"
                                       FontSize="14" TextColor="#1B2D3E"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="0.5" Color="#EFF3F8"
                                 IsVisible="{Binding Source={x:Reference ArtisanSpecialityRow}, Path=IsVisible}"/>

                        <Grid x:Name="ExperienceLevelRow"
                              ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              Padding="16,13" IsVisible="False">
                            <Frame Grid.Column="0" BackgroundColor="#EBF3FB" CornerRadius="12"
                                   Padding="0" HasShadow="False"
                                   WidthRequest="38" HeightRequest="38">
                                <Image Source="chart.svg"
                                       WidthRequest="18" HeightRequest="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center" Spacing="1">
                                <Label Text="EXPERIENCE LEVEL" FontSize="8"
                                       TextColor="#8BAFC9" CharacterSpacing="0.8"/>
                                <Label x:Name="ExperienceLevelLabel"
                                       FontSize="14" TextColor="#1B2D3E"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="0.5" Color="#EFF3F8"
                                 IsVisible="{Binding Source={x:Reference ExperienceLevelRow}, Path=IsVisible}"/>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"
                              Padding="16,13">

                            <Frame x:Name="HourlyRateBox" Grid.Column="0"
                                   BackgroundColor="#F8FAFC" CornerRadius="12"
                                   Padding="12,10" HasShadow="False"
                                   BorderColor="#E2E8F0" IsVisible="False">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="RATE" FontSize="8"
                                           TextColor="#8BAFC9" CharacterSpacing="0.6"/>
                                    <Label x:Name="HourlyRateLabel"
                                           FontSize="13" TextColor="#1B2D3E"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame x:Name="ServiceRadiusBox" Grid.Column="1"
                                   BackgroundColor="#F8FAFC" CornerRadius="12"
                                   Padding="12,10" HasShadow="False"
                                   BorderColor="#E2E8F0" IsVisible="False">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="RADIUS" FontSize="8"
                                           TextColor="#8BAFC9" CharacterSpacing="0.6"/>
                                    <Label x:Name="ServiceRadiusLabel"
                                           FontSize="13" TextColor="#1B2D3E"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Frame x:Name="AvailabilityBadge" Grid.Column="2"
                                   CornerRadius="12" Padding="12,10"
                                   HasShadow="False"
                                   BackgroundColor="#DCFCE7"
                                   BorderColor="Transparent">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="STATUS" FontSize="8"
