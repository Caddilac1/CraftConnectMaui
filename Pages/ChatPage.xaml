<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.ChatPage"
             xmlns:pagemodels="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
             x:DataType="pagemodels:ChatPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#ECE5DD">

    <Shell.TitleView>
        <Grid/>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:UrlToImageConverter x:Key="UrlToImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root Grid — chat UI in rows, recording banner overlays at bottom -->
    <Grid>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

            <!-- ══ WHATSAPP-STYLE HEADER ══════════════════════════════════ -->
            <Grid Grid.Row="0"
                  BackgroundColor="#075E54"
                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                  Padding="6,0,6,0"
                  HeightRequest="62">

                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="6,8,6,8"/>
                        <On Platform="iOS"     Value="6,48,6,8"/>
                    </OnPlatform>
                </Grid.Padding>

                <!-- Back arrow -->
                <Border Grid.Column="0"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="24"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>

                <!-- Avatar circle with initials + online green dot -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40"
                      VerticalOptions="Center" Margin="2,0,10,0">
                    <Border WidthRequest="40" HeightRequest="40"
                            BackgroundColor="#128C7E" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding GroupName, Converter={StaticResource FirstLetterConverter}}"
                               FontSize="17" FontAttributes="Bold" TextColor="White"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                    <Border WidthRequest="12" HeightRequest="12"
                            BackgroundColor="#25D366" StrokeThickness="1.5"
                            HorizontalOptions="End" VerticalOptions="End">
                        <Border.Stroke>
                            <SolidColorBrush Color="#075E54"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                    </Border>
                </Grid>

                <!-- Group name + member count -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding GroupName}"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="TailTruncation"/>
                    <Label Text="12 members, 8 online"
                           FontSize="12" TextColor="#B2DFDB"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Video call icon -->
                <Border Grid.Column="3"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe04b;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>

                <!-- Phone icon -->
                <Border Grid.Column="4"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe0cd;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>

                <!-- More / kebab menu -->
                <Border Grid.Column="5"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe5d4;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
            </Grid>

            <!-- ══ MESSAGES AREA ════════════════════════════════════════ -->
            <Grid Grid.Row="1" BackgroundColor="#ECE5DD">

                <CollectionView x:Name="MessagesCollectionView"
                                ItemsSource="{Binding Messages}"
                                SelectionMode="None"
                                BackgroundColor="Transparent">

                    <CollectionView.Header>
                        <Grid Padding="0,10,0,6">
                            <Border BackgroundColor="White" StrokeThickness="0"
                                    Padding="14,4" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="TODAY" FontSize="12" TextColor="#667781"
                                       FontAttributes="Bold" CharacterSpacing="1.5"/>
                            </Border>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" VerticalOptions="Center"
                                             HorizontalOptions="Center" Spacing="12">
                            <Border WidthRequest="72" HeightRequest="72"
                                    BackgroundColor="White" StrokeThickness="0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36"/>
                                </Border.StrokeShape>
                                <Label Text="&#xe0c9;" FontFamily="MaterialIcons" FontSize="36"
                                       TextColor="#B0BEC5" HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="No messages yet" FontSize="16" TextColor="#546E7A"
                                   HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                            <Label Text="Send a message to start the conversation"
                                   FontSize="13" TextColor="#90A4AE"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="pagemodels:GroupMessageItemViewModel">
                            <Grid Padding="6,2,6,2">

                                <!-- ── INCOMING (LEFT) ────────────────── -->
                                <VerticalStackLayout
                                    IsVisible="{Binding IsFromCurrentUser, Converter={StaticResource InvertedBoolConverter}}"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="290"
                                    Spacing="0">

                                    <Label Text="{Binding DisplayName}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#075E54"
                                           Margin="12,4,12,0"
                                           IsVisible="{Binding IsFromCurrentUser, Converter={StaticResource InvertedBoolConverter}}"/>

                                    <Border BackgroundColor="White"
                                            StrokeThickness="0"
                                            Padding="10,6,10,6"
                                            Margin="0,2,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="0,8,8,8"/>
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="2">

                                            <Label Text="{Binding Message}"
                                                   FontSize="15" TextColor="#111B21"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding HasMessageText}"/>

                                            <!-- Image attachment -->
                                            <Border IsVisible="{Binding IsImageAttachment}"
                                                    StrokeThickness="0" Padding="0"
                                                    Margin="0,4,0,0" MaximumWidthRequest="240">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <Image Source="{Binding AttachmentUrl, Converter={StaticResource UrlToImageConverter}}"
                                                           Aspect="AspectFill" HeightRequest="180" WidthRequest="240"
                                                           Opacity="0.4"
                                                           IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"/>
                                                    <Image Source="{Binding LocalFilePath}"
                                                           Aspect="AspectFill" HeightRequest="180" WidthRequest="240"
                                                           IsVisible="{Binding IsDownloaded}">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnImageTapped"/>
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Grid IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"
                                                          BackgroundColor="#60000000">
                                                        <Border WidthRequest="52" HeightRequest="52"
                                                                BackgroundColor="#075E54" StrokeThickness="0"
                                                                HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="26"/>
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDownloadAttachment"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid>
                                                                <ActivityIndicator IsRunning="{Binding IsDownloading}"
                                                                                   IsVisible="{Binding IsDownloading}"
                                                                                   Color="White" WidthRequest="32" HeightRequest="32"/>
                                                                <Label Text="{Binding DownloadIcon}" FontSize="24"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <Label Text="{Binding DownloadStatusText}"
                                                               TextColor="White" FontSize="11"
                                                               HorizontalOptions="Center" VerticalOptions="End"
                                                               Margin="0,0,0,8" Padding="6,2"/>
                                                    </Grid>
                                                    <Label Text="✓" TextColor="#25D366" FontSize="14"
                                                           BackgroundColor="#60FFFFFF" Padding="4"
                                                           WidthRequest="22" HeightRequest="22"
                                                           HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                           IsVisible="{Binding IsDownloaded}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Document attachment -->
                                            <Border IsVisible="{Binding IsDocumentAttachment}"
                                                    BackgroundColor="#F0F0F0" StrokeThickness="0"
                                                    Padding="10,8" Margin="0,4,0,0" MaximumWidthRequest="240">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachment"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                                                BackgroundColor="#075E54" StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding AttachmentIcon}"
                                                                   FontFamily="MaterialIcons" FontSize="24"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding AttachmentName}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   TextColor="#111B21" LineBreakMode="TailTruncation"/>
                                                            <Label Text="{Binding AttachmentSize}"
                                                                   FontSize="11" TextColor="#667781"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    <Border IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"
                                                            WidthRequest="32" HeightRequest="32"
                                                            BackgroundColor="#075E54" StrokeThickness="0"
                                                            HorizontalOptions="End" VerticalOptions="End"
                                                            Margin="0,0,-4,-4">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16"/>
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnDownloadAttachment"
                                                                                  CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <Grid>
                                                            <ActivityIndicator IsRunning="{Binding IsDownloading}"
                                                                               IsVisible="{Binding IsDownloading}"
                                                                               Color="White" WidthRequest="20" HeightRequest="20"/>
                                                            <Label Text="{Binding DownloadIcon}" FontSize="16"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                                   IsVisible="{Binding IsDownloading, Converter={StaticResource InvertedBoolConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border IsVisible="{Binding IsDownloaded}"
                                                            WidthRequest="20" HeightRequest="20"
                                                            BackgroundColor="#25D366" StrokeThickness="0"
                                                            HorizontalOptions="End" VerticalOptions="Start"
                                                            Margin="0,-4,-4,0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="✓" TextColor="White" FontSize="12"
                                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Label Text="{Binding DisplayTime}"
                                                   FontSize="11" TextColor="#667781"
                                                   HorizontalOptions="End" Margin="0,2,0,0"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- ── OUTGOING (RIGHT) ───────────────── -->
                                <VerticalStackLayout
                                    IsVisible="{Binding IsFromCurrentUser}"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="290"
                                    Spacing="0">

                                    <Border BackgroundColor="#DCF8C6"
                                            StrokeThickness="0"
                                            Padding="10,6,10,6"
                                            Margin="0,2,0,2">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8,0,8,8"/>
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="2">

                                            <Label Text="{Binding Message}"
                                                   FontSize="15" TextColor="#111B21"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding HasMessageText}"/>

                                            <!-- Image attachment -->
                                            <Border IsVisible="{Binding IsImageAttachment}"
                                                    StrokeThickness="0" Padding="0"
                                                    Margin="0,4,0,0" MaximumWidthRequest="240">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Grid>
                                                    <Image Source="{Binding AttachmentUrl, Converter={StaticResource UrlToImageConverter}}"
                                                           Aspect="AspectFill" HeightRequest="180" WidthRequest="240"
                                                           Opacity="0.4"
                                                           IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"/>
                                                    <Image Source="{Binding LocalFilePath}"
                                                           Aspect="AspectFill" HeightRequest="180" WidthRequest="240"
                                                           IsVisible="{Binding IsDownloaded}">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnImageTapped"/>
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Grid IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"
                                                          BackgroundColor="#60000000">
                                                        <Border WidthRequest="52" HeightRequest="52"
                                                                BackgroundColor="#075E54" StrokeThickness="0"
                                                                HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="26"/>
                                                            </Border.StrokeShape>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDownloadAttachment"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid>
                                                                <ActivityIndicator IsRunning="{Binding IsDownloading}"
                                                                                   IsVisible="{Binding IsDownloading}"
                                                                                   Color="White" WidthRequest="32" HeightRequest="32"/>
                                                                <Label Text="{Binding DownloadIcon}" FontSize="24"
                                                                       TextColor="White"
                                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <Label Text="{Binding DownloadStatusText}"
                                                               TextColor="White" FontSize="11"
                                                               HorizontalOptions="Center" VerticalOptions="End"
                                                               Margin="0,0,0,8" Padding="6,2"/>
                                                    </Grid>
                                                    <Label Text="✓" TextColor="#25D366" FontSize="14"
                                                           BackgroundColor="#60FFFFFF" Padding="4"
                                                           WidthRequest="22" HeightRequest="22"
                                                           HorizontalOptions="End" VerticalOptions="Start" Margin="4"
                                                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                           IsVisible="{Binding IsDownloaded}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Document attachment -->
                                            <Border IsVisible="{Binding IsDocumentAttachment}"
                                                    BackgroundColor="#B9F5CE" StrokeThickness="0"
                                                    Padding="10,8" Margin="0,4,0,0" MaximumWidthRequest="240">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDownloadAttachment"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                        <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                                                BackgroundColor="#128C7E" StrokeThickness="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding AttachmentIcon}"
                                                                   FontFamily="MaterialIcons" FontSize="24"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding AttachmentName}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   TextColor="#111B21" LineBreakMode="TailTruncation"/>
                                                            <Label Text="{Binding AttachmentSize}"
                                                                   FontSize="11" TextColor="#667781"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    <Border IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}"
                                                            WidthRequest="32" HeightRequest="32"
                                                            BackgroundColor="#128C7E" StrokeThickness="0"
                                                            HorizontalOptions="End" VerticalOptions="End"
                                                            Margin="0,0,-4,-4">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16"/>
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnDownloadAttachment"
                                                                                  CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <Grid>
                                                            <ActivityIndicator IsRunning="{Binding IsDownloading}"
                                                                               IsVisible="{Binding IsDownloading}"
                                                                               Color="White" WidthRequest="20" HeightRequest="20"/>
                                                            <Label Text="{Binding DownloadIcon}" FontSize="16"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                                   IsVisible="{Binding IsDownloading, Converter={StaticResource InvertedBoolConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border IsVisible="{Binding IsDownloaded}"
                                                            WidthRequest="20" HeightRequest="20"
                                                            BackgroundColor="#25D366" StrokeThickness="0"
                                                            HorizontalOptions="End" VerticalOptions="Start"
                                                            Margin="0,-4,-4,0">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="10"/>
                                                        </Border.StrokeShape>
                                                        <Label Text="✓" TextColor="White" FontSize="12"
                                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <HorizontalStackLayout HorizontalOptions="End" Spacing="3" Margin="0,2,0,0">
                                                <Label Text="{Binding DisplayTime}"
                                                       FontSize="11" TextColor="#667781"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding StatusIcon}"
                                                       FontSize="13" TextColor="#667781"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding IsFromCurrentUser}"/>
                                            </HorizontalStackLayout>

                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Loading spinner -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#075E54"
                                   WidthRequest="28" HeightRequest="28"
                                   VerticalOptions="Start" HorizontalOptions="Center"
                                   Margin="0,12,0,0" ZIndex="99"/>
            </Grid>

            <!-- ══ INPUT BAR ══════════════════════════════════════════ -->
            <Grid x:Name="MessageInputArea"
                  Grid.Row="2"
                  BackgroundColor="#F0F2F5"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="8,6,8,10"/>
                        <On Platform="Default" Value="8,6,8,6"/>
                    </OnPlatform>
                </Grid.Padding>

                <!-- Input pill -->
                <Border Grid.Column="0"
                        BackgroundColor="White" StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumHeightRequest="46" MaximumHeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0" Padding="6,0">

                        <Border Grid.Column="0"
                                BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEmojiButtonTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe24e;" FontFamily="MaterialIcons" FontSize="24"
                                   TextColor="#8696A0" VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>

                        <Editor Grid.Column="1"
                                x:Name="MessageEditor"
                                Text="{Binding MessageText}"
                                Placeholder="Type a message"
                                AutoSize="TextChanges"
                                FontSize="16"
                                TextColor="#111B21"
                                PlaceholderColor="#8696A0"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                MinimumHeightRequest="28"
                                MaximumHeightRequest="100"
                                Focused="OnMessageEditorFocused"
                                Unfocused="OnMessageEditorUnfocused"/>

                        <!-- Attachment + Camera — only when no text and not recording -->
                        <HorizontalStackLayout Grid.Column="2"
                                               Spacing="2" VerticalOptions="Center"
                                               Margin="0,0,6,0"
                                               IsVisible="{Binding ShowAttachmentIcons}">
                            <Border BackgroundColor="Transparent" StrokeThickness="0"
                                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAttachmentButtonTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#xe226;" FontFamily="MaterialIcons" FontSize="24"
                                       TextColor="#8696A0" Rotation="-45"
                                       VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                            <Border BackgroundColor="Transparent" StrokeThickness="0"
                                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCameraButtonTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#xe3b0;" FontFamily="MaterialIcons" FontSize="24"
                                       TextColor="#8696A0" VerticalOptions="Center" HorizontalOptions="Center"/>
                            </Border>
                        </HorizontalStackLayout>

                    </Grid>
                </Border>

                <!-- ── SEND / MIC button ────────────────────────────── -->
                <!--
                    No text + idle    → teal, shows mic icon    → tap starts recording
                    No text + recording → red, shows stop icon  → tap stops & sends
                    Text present      → teal, shows send icon   → tap sends text
                -->
                <Border Grid.Column="1"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="{Binding SendButtonColor}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendMicTapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- Mic — idle, no text -->
                        <Label Text="&#xe029;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ShowMicIcon}"/>
                        <!-- Stop square — while recording -->
                        <Label Text="&#xe047;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding IsRecording}"/>
                        <!-- Send arrow — when text present -->
                        <Label Text="&#xe163;" FontFamily="MaterialIcons" FontSize="24"
                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding ShowSendIcon}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ RECORDING BANNER — slides above input bar while recording ══ -->
        <Border x:Name="RecordingBanner"
                IsVisible="{Binding IsRecording}"
                BackgroundColor="#D32F2F"
                StrokeThickness="0"
                VerticalOptions="End"
                HorizontalOptions="FillAndExpand"
                Padding="20,12"
                Margin="0,0,0,70">
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                <Ellipse x:Name="RecordingDot"
                         WidthRequest="10" HeightRequest="10"
                         Fill="White" VerticalOptions="Center"/>
                <Label Text="Recording... tap ■ to stop &amp; send"
                       FontSize="13" TextColor="White" VerticalOptions="Center"/>
                <Label Text="{Binding RecordingDuration}"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

    </Grid>
</ContentPage>
