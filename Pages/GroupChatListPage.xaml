<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:models="clr-namespace:CraftConnect_Mobile_App.Models"
             xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
             xmlns:controls="clr-namespace:CraftConnect_Mobile_App.Pages"
             x:Class="CraftConnect_Mobile_App.Pages.GroupChatListPage"
             x:DataType="vm:GroupChatListPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F2F4F7">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- ══════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Padding="20,52,20,12"
              BackgroundColor="#F2F4F7"
              ColumnDefinitions="*,Auto">

            <Label Text="Chats"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#0D0D0D"
                   VerticalOptions="Center"/>

            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">

                <Border WidthRequest="40" HeightRequest="40"
                        BackgroundColor="#FFFFFF" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="4" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditModeClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="⋮" FontSize="20" TextColor="#0D0D0D"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Border WidthRequest="40" HeightRequest="40"
                        BackgroundColor="#0D0D0D" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddGroupClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="+" FontSize="24" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Margin="0,-1,0,0"/>
                </Border>

            </HorizontalStackLayout>
        </Grid>

        <!-- ══════════════════════════════════════════════
             SEARCH BAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="20,0,20,14"
                BackgroundColor="#FFFFFF"
                Padding="14,0"
                HeightRequest="46"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,1" Radius="6" Opacity="0.05"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔍" FontSize="15" Opacity="0.4" VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       Placeholder="Search conversations"
                       PlaceholderColor="#AAAAAA"
                       TextColor="#0D0D0D"
                       FontSize="15"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
             FILTER CHIPS
             FIX: No HeightRequest — let content size naturally.
             Added Padding bottom on ScrollView and top/bottom
             on the HorizontalStackLayout so chips breathe and
             are never clipped by the container.
        ══════════════════════════════════════════════ -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="20,2,20,14">
            <HorizontalStackLayout Spacing="8" Padding="0,2,0,2">

                <Border x:Name="AllChip"
                        BackgroundColor="#0D0D0D"
                        Padding="18,10" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterAllClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="All" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </Border>

                <Border BackgroundColor="#FFFFFF" Padding="18,10" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterUnreadClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Unread" TextColor="#555555" FontSize="13"/>
                </Border>

                <Border BackgroundColor="#FFFFFF" Padding="18,10" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterGroupsClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Groups" TextColor="#555555" FontSize="13"/>
                </Border>

                <Border BackgroundColor="#FFFFFF" Padding="18,10" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterPersonalClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="Personal" TextColor="#555555" FontSize="13"/>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════
             CHAT LIST
        ══════════════════════════════════════════════ -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Groups}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                        BackgroundColor="Transparent"
                        Margin="20,0,20,8">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="10" Padding="32,60">
                    <Label Text="💬" FontSize="52" HorizontalOptions="Center" Opacity="0.18"/>
                    <Label Text="No conversations yet"
                           FontSize="17" FontAttributes="Bold" TextColor="#0D0D0D"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Tap + to start a new chat"
                           FontSize="14" TextColor="#999999" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GroupChatItem">

                    <Border Margin="0,0,0,10"
                            BackgroundColor="#FFFFFF"
                            Padding="14,14"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.06"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- ── AVATAR + BADGE ──────────────────────────────
                                 Outer grid is 62x62 so the badge (22x22) hanging
                                 off the top-right corner is not clipped.
                                 Avatar is 54x54 anchored bottom-left inside it. -->
                            <Grid WidthRequest="62" HeightRequest="62" VerticalOptions="Center">

                                <Border WidthRequest="54" HeightRequest="54"
                                        StrokeThickness="0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4A90D9" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="{Binding Initial}"
                                           FontSize="18" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <!-- Badge — visible when UnreadCount > 0 -->
                                <Border IsVisible="{Binding HasUnreadMessages}"
                                        BackgroundColor="#FF6B00"
                                        MinimumWidthRequest="22"
                                        HeightRequest="22"
                                        Padding="5,1"
                                        StrokeThickness="2"
                                        Stroke="#FFFFFF"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding UnreadCount}"
                                           FontSize="11" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                            </Grid>

                            <!-- ── NAME + LAST MESSAGE + DEBUG ROW ─────────── -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">

                                <Label Text="{Binding Name}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#0D0D0D"
                                       LineBreakMode="TailTruncation" MaxLines="1"/>

                                <Label Text="{Binding LastMessage}"
                                       FontSize="13" TextColor="#888888"
                                       LineBreakMode="TailTruncation" MaxLines="1">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding LastMessage}" Value="{x:Null}">
                                            <Setter Property="Text" Value="No messages yet"/>
                                            <Setter Property="TextColor" Value="#BBBBBB"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding LastMessage}" Value="">
                                            <Setter Property="Text" Value="No messages yet"/>
                                            <Setter Property="TextColor" Value="#BBBBBB"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>



                            </VerticalStackLayout>

                            <!-- ── TIME ───────────────────────────────────── -->
                            <Label Grid.Column="2"
                                   Text="{Binding DisplayTime}"
                                   FontSize="11" TextColor="#AAAAAA"
                                   VerticalOptions="Start" HorizontalOptions="End"
                                   Margin="0,2,0,0"/>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- BOTTOM NAV -->
        <controls:BottomNavBar Grid.Row="4" ActiveTab="Chats"/>

    </Grid>
</ContentPage>
