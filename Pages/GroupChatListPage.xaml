<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:models="clr-namespace:CraftConnect_Mobile_App.Models"
             xmlns:controls="clr-namespace:CraftConnect_Mobile_App.Pages"
             x:Class="CraftConnect_Mobile_App.Pages.GroupChatListPage"
             x:DataType="vm:GroupChatListPageModel"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="#F0F4FF">

    <Grid>
        <BoxView Color="#F0F4FF"/>

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

            <!-- ════════════════════════════════════
                 HEADER
                 ════════════════════════════════════ -->
            <Grid Grid.Row="0"
                  Padding="20,52,20,16"
                  BackgroundColor="#F0F4FF"
                  ColumnDefinitions="*,Auto">

                <Label Text="Chats"
                       FontSize="32" FontAttributes="Bold"
                       TextColor="#0D0D0D" VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Border x:Name="MoreOptionsBtn"
                            WidthRequest="42" HeightRequest="42"
                            BackgroundColor="#1A2340" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.18"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditModeClicked"/>
                        </Border.GestureRecognizers>
                        <Image Source="icon_more_vert.svg"
                               WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Border x:Name="AddGroupBtn"
                            WidthRequest="42" HeightRequest="42"
                            BackgroundColor="#2563EB" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#2563EB" Offset="0,3" Radius="8" Opacity="0.35"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddGroupClicked"/>
                        </Border.GestureRecognizers>
                        <Image Source="icon_plus.svg"
                               WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ════════════════════════════════════
                 SEARCH BAR
                 ════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Margin="20,0,20,14"
                    BackgroundColor="#FFFFFF"
                    Padding="14,0" HeightRequest="48" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#2563EB" Offset="0,1" Radius="6" Opacity="0.06"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image Source="icon_search_dark.svg"
                           WidthRequest="16" HeightRequest="16"
                           Opacity="0.35" VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search conversations"
                           PlaceholderColor="#BBBBBB"
                           TextColor="#0D0D0D" FontSize="15"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════
                 FILTER CHIPS
                 ════════════════════════════════════ -->
            <ScrollView Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="20,0,20,10">
                <HorizontalStackLayout Spacing="8" Padding="0,2,0,2">

                    <Border x:Name="ChipAll" BackgroundColor="#2563EB" Padding="20,10" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#2563EB" Offset="0,2" Radius="6" Opacity="0.28"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterAllClicked"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="ChipAllLabel" Text="All" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    </Border>

                    <Border x:Name="ChipUnread" BackgroundColor="#FFFFFF" Padding="20,10" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterUnreadClicked"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="ChipUnreadLabel" Text="Unread" TextColor="#555555" FontSize="13"/>
                    </Border>

                    <Border x:Name="ChipGroups" BackgroundColor="#FFFFFF" Padding="20,10" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterGroupsClicked"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="ChipGroupsLabel" Text="Groups" TextColor="#555555" FontSize="13"/>
                    </Border>

                </HorizontalStackLayout>
            </ScrollView>

            <!-- ════════════════════════════════════
                 UNIFIED CHAT LIST
                 ════════════════════════════════════ -->
            <CollectionView Grid.Row="3"
                            ItemsSource="{Binding ChatItems}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedChatItem, Mode=TwoWay}"
                            BackgroundColor="Transparent"
                            Margin="20,0,20,8">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                         Spacing="12" Padding="32,60">
                        <Label Text="No chats yet"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="#0D0D0D" HorizontalTextAlignment="Center"/>
                        <Label Text="Tap + to create a group or message someone"
                               FontSize="14" TextColor="#999999" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatListItem">
                        <Border Margin="0,0,0,10"
                                BackgroundColor="#FFFFFF"
                                Padding="14,14" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#2563EB" Offset="0,2" Radius="8" Opacity="0.05"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Avatar -->
                                <Grid WidthRequest="62" HeightRequest="62" VerticalOptions="Center">
                                    <Border WidthRequest="54" HeightRequest="54"
                                            StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="End">
                                        <Border.StrokeShape>
                                            <!-- Groups = rounded square, DMs = circle -->
                                            <RoundRectangle CornerRadius="{Binding AvatarCornerRadius}"/>
                                        </Border.StrokeShape>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{Binding AvatarGradientStart}" Offset="0"/>
                                                <GradientStop Color="{Binding AvatarGradientEnd}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="{Binding Initial}" FontSize="20" FontAttributes="Bold"
                                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Unread badge -->
                                    <Border IsVisible="{Binding HasUnreadMessages}"
                                            BackgroundColor="#1A2340"
                                            MinimumWidthRequest="22" HeightRequest="22"
                                            Padding="5,1" StrokeThickness="2" Stroke="#FFFFFF"
                                            HorizontalOptions="End" VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="11"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding UnreadCount}" FontSize="11"
                                               FontAttributes="Bold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Name + last message -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding DisplayName}" FontSize="15"
                                               FontAttributes="Bold" TextColor="#0D0D0D"
                                               LineBreakMode="TailTruncation" MaxLines="1"/>
                                        <!-- DM lock badge -->
                                        <Border IsVisible="{Binding IsDm}"
                                                BackgroundColor="#EEF3FF" Padding="4,2" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="&#xE897;" FontFamily="MaterialIcons"
                                                   FontSize="10" TextColor="#2563EB"/>
                                        </Border>
                                        <!-- Group badge -->
                                        <Border IsVisible="{Binding IsGroup}"
                                                BackgroundColor="#EEF3FF" Padding="4,2" StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="&#xE7EF;" FontFamily="MaterialIcons"
                                                   FontSize="10" TextColor="#2563EB"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding LastMessage}" FontSize="13" TextColor="#888888"
                                           LineBreakMode="TailTruncation" MaxLines="1"/>
                                </VerticalStackLayout>

                                <!-- Time -->
                                <Label Grid.Column="2" Text="{Binding DisplayTime}"
                                       FontSize="11" TextColor="#AAAAAA"
                                       VerticalOptions="Start" HorizontalOptions="End" Margin="0,2,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- BOTTOM NAV -->
            <controls:BottomNavBar x:Name="BottomNav" Grid.Row="4" ActiveTab="Chats"/>

        </Grid>
    </Grid>
</ContentPage>
