<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.RegisterPage"
             xmlns:pagemodels="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:controls="clr-namespace:CraftConnect_Mobile_App.Controls"
             x:DataType="pagemodels:RegisterPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1B2B3A">

    <Grid>
        <!-- Background split -->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.36*"/>
            <RowDefinition Height="0.64*"/>
        </Grid.RowDefinitions>

        <BoxView Grid.Row="0" Color="#1B2B3A"/>

        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="36,36,0,0"/>
            </Border.StrokeShape>
        </Border>

        <!-- Scrollable content -->
        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout Spacing="0"
                                 Padding="{OnPlatform Android='0,0,0,60', Default='0,0,0,40'}">

                <!-- ══ HERO ══════════════════════════════════════════ -->
                <VerticalStackLayout Padding="24,52,24,32"
                                     Spacing="12"
                                     HorizontalOptions="Center">

                    <Frame BackgroundColor="White"
                           CornerRadius="22"
                           HasShadow="True"
                           WidthRequest="100"
                           HeightRequest="100"
                           Padding="0"
                           HorizontalOptions="Center"
                           IsClippedToBounds="True">
                        <Label Text="🔧"
                               FontSize="54"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>

                    <Label Text="CraftConnect"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="◆" FontSize="10" TextColor="#2DC98E" VerticalOptions="Center"/>
                        <Label Text="Where Craftsmanship Meets Opportunity"
                               FontSize="12" TextColor="#8AABB8" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <!-- ══ FORM PANEL ════════════════════════════════════ -->
                <VerticalStackLayout BackgroundColor="White"
                                     Padding="28,32,28,28"
                                     Spacing="0">

                    <Label Text="Create Account"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="#1B2B3A"
                           HorizontalOptions="Center"
                           Margin="0,0,0,4"/>

                    <Label Text="Join the CraftConnect community today"
                           FontSize="13"
                           TextColor="#8899A8"
                           HorizontalOptions="Center"
                           Margin="0,0,0,24"/>

                    <!-- ══ ROLE SELECTOR ══════════════════════════════ -->
                    <Label Text="I am joining as"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#1B2B3A"
                           Margin="0,0,0,12"/>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,10">

                        <!-- Customer -->
                        <Border Grid.Column="0" StrokeThickness="2" HeightRequest="76">
                            <Border.Stroke>
                                <SolidColorBrush Color="{Binding CustomerBorderColor}"/>
                            </Border.Stroke>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding CustomerBackgroundColor}"/>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectRegistrationTypeCommand}"
                                                          CommandParameter="Customer"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="🛒" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Customer"
                                           FontSize="11"
                                           FontAttributes="{Binding CustomerLabelFontAttributes}"
                                           TextColor="{Binding CustomerLabelColor}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Artisan -->
                        <Border Grid.Column="1" StrokeThickness="2" HeightRequest="76">
                            <Border.Stroke>
                                <SolidColorBrush Color="{Binding ArtisanBorderColor}"/>
                            </Border.Stroke>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding ArtisanBackgroundColor}"/>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectRegistrationTypeCommand}"
                                                          CommandParameter="Artisan"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="🔨" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Artisan"
                                           FontSize="11"
                                           FontAttributes="{Binding ArtisanLabelFontAttributes}"
                                           TextColor="{Binding ArtisanLabelColor}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Company Owner -->
                        <Border Grid.Column="2" StrokeThickness="2" HeightRequest="76">
                            <Border.Stroke>
                                <SolidColorBrush Color="{Binding CompanyOwnerBorderColor}"/>
                            </Border.Stroke>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding CompanyOwnerBackgroundColor}"/>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectRegistrationTypeCommand}"
                                                          CommandParameter="CompanyOwner"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                    <Label Text="🏢" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Company"
                                           FontSize="11"
                                           FontAttributes="{Binding CompanyOwnerLabelFontAttributes}"
                                           TextColor="{Binding CompanyOwnerLabelColor}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- Artisan auto-company note — only visible when Artisan selected -->
                    <Border IsVisible="{Binding IsArtisanSelected}"
                            StrokeThickness="1"
                            Margin="0,2,0,8">
                        <Border.Stroke>
                            <SolidColorBrush Color="#BBE0FF"/>
                        </Border.Stroke>
                        <Border.Background>
                            <SolidColorBrush Color="#EEF6FF"/>
                        </Border.Background>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Padding="12,9" Spacing="8">
                            <Label Text="ℹ️" FontSize="13" VerticalOptions="Center"/>
                            <Label Text="Artisan accounts automatically include a company profile so clients can discover your business."
                                   FontSize="11"
                                   TextColor="#1A4DAD"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Active role badge pill -->
                    <Border HorizontalOptions="Center"
                            StrokeThickness="1.5"
                            Margin="0,8,0,24">
                        <Border.Stroke>
                            <SolidColorBrush Color="#D1E8FF"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Padding="16,10" Spacing="8">
                            <Label Text="{Binding RegistrationTypeBadgeIcon}"
                                   FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding RegistrationTypeBadgeText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1A4DAD"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- ══ SECTION: Personal Information ═════════════ -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,18">
                        <BoxView Grid.Column="0" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Personal Information"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#9BAABB"
                               Margin="10,0"/>
                        <BoxView Grid.Column="2" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                    </Grid>

                    <!-- First Name -->
                    <Label Text="First Name"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                            <Label Grid.Column="0" Text="👤" FontSize="18" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Enter your first name"
                                   Text="{Binding FirstName}"
                                   Keyboard="Text"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Last Name -->
                    <Label Text="Last Name"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                            <Label Grid.Column="0" Text="👤" FontSize="18" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Enter your last name"
                                   Text="{Binding LastName}"
                                   Keyboard="Text"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Email -->
                    <Label Text="Email Address"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                            <Label Grid.Column="0" Text="✉" FontSize="18" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Enter your email address"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Phone -->
                    <Label Text="Phone Number"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                            <Label Grid.Column="0" Text="📱" FontSize="18" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Enter your phone number"
                                   Text="{Binding Phone}"
                                   Keyboard="Telephone"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Address (optional) -->
                    <Label Text="Address (Optional)"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                            <Label Grid.Column="0" Text="📍" FontSize="18" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Enter your home address"
                                   Text="{Binding Address}"
                                   Keyboard="Text"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Password -->
                    <Label Text="Password"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,18">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0">
                            <Label Grid.Column="0" Text="🔒" FontSize="16" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Create a password (min. 8 chars)"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                            <Label Grid.Column="2"
                                   Text="{Binding IsPasswordVisible, Converter={StaticResource PasswordTextConverter}}"
                                   FontSize="20" TextColor="#9BAABB"
                                   VerticalOptions="Center" Padding="10,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- Confirm Password -->
                    <Label Text="Confirm Password"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,8"/>
                    <Border StrokeThickness="1.5" Margin="0,0,0,28">
                        <Border.Stroke>
                            <SolidColorBrush Color="#E4EAF0"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0">
                            <Label Grid.Column="0" Text="🔒" FontSize="16" TextColor="#9BAABB"
                                   VerticalOptions="Center" Margin="0,0,10,0"/>
                            <Entry Grid.Column="1"
                                   Placeholder="Re-enter your password"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="{Binding IsConfirmPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   BackgroundColor="Transparent"/>
                            <Label Grid.Column="2"
                                   Text="{Binding IsConfirmPasswordVisible, Converter={StaticResource PasswordTextConverter}}"
                                   FontSize="20" TextColor="#9BAABB"
                                   VerticalOptions="Center" Padding="10,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordVisibilityCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- ══ BUSINESS SECTION — Artisan + CompanyOwner only ══ -->
                    <VerticalStackLayout IsVisible="{Binding IsBusinessSectionVisible}" Spacing="0">

                        <!-- Section divider -->
                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,18">
                            <BoxView Grid.Column="0" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Business Details"
                                   FontSize="11" FontAttributes="Bold" TextColor="#9BAABB"
                                   Margin="10,0"/>
                            <BoxView Grid.Column="2" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Business Name -->
                        <Label Text="Business Name"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="🏷️" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter your business name"
                                       Text="{Binding BusinessName}"
                                       Keyboard="Text"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Business Type — loaded from GET /api/lookup/business-types -->
                        <Label Text="Business Type"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="📋" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Picker Grid.Column="1"
                                        Title="Select a business type"
                                        ItemsSource="{Binding BusinessTypes}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedBusinessType}"
                                        TextColor="#1B2B3A"
                                        TitleColor="#B0BEC8"
                                        FontSize="14"
                                        HeightRequest="54"
                                        BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Business Description (optional) -->
                        <Label Text="Business Description (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Editor Placeholder="Describe what your business does…"
                                    Text="{Binding BusinessDescription}"
                                    TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                    FontSize="14" HeightRequest="90"
                                    Margin="16,8"
                                    BackgroundColor="Transparent"/>
                        </Border>

                        <!-- Business Phone (optional) -->
                        <Label Text="Business Phone (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="📞" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter business phone number"
                                       Text="{Binding BusinessPhone}"
                                       Keyboard="Telephone"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Business Email (optional) -->
                        <Label Text="Business Email (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="✉" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter business email address"
                                       Text="{Binding BusinessEmail}"
                                       Keyboard="Email"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Business Address (optional) -->
                        <Label Text="Business Address (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,28">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="📍" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter business address"
                                       Text="{Binding BusinessAddress}"
                                       Keyboard="Text"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- ── PRIMARY LOCATION sub-section ─────────── -->
                        <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,14">
                            <BoxView Grid.Column="0" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="Primary Location"
                                   FontSize="11" FontAttributes="Bold" TextColor="#9BAABB"
                                   Margin="10,0"/>
                            <BoxView Grid.Column="2" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Location hint banner -->
                        <Border StrokeThickness="1" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#BBE0FF"/>
                            </Border.Stroke>
                            <Border.Background>
                                <SolidColorBrush Color="#EEF6FF"/>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Padding="12,9" Spacing="8">
                                <Label Text="📌" FontSize="13" VerticalOptions="Center"/>
                                <Label Text="Add your primary branch or workshop. You can add more locations from your dashboard later."
                                       FontSize="11" TextColor="#1A4DAD"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Location Name -->
                        <Label Text="Location Name"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="🏪" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="e.g. Main Branch, Workshop A"
                                       Text="{Binding LocationName}"
                                       Keyboard="Text"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Location Town -->
                        <Label Text="Town / City"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="🌍" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter town or city"
                                       Text="{Binding LocationTown}"
                                       Keyboard="Text"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Location Address (optional) -->
                        <Label Text="Location Address (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,18">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="📍" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter location street address"
                                       Text="{Binding LocationAddress}"
                                       Keyboard="Text"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                        <!-- Location Phone (optional) -->
                        <Label Text="Location Phone (Optional)"
                               FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                               Margin="0,0,0,8"/>
                        <Border StrokeThickness="1.5" Margin="0,0,0,28">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                                <Label Grid.Column="0" Text="📞" FontSize="18" TextColor="#9BAABB"
                                       VerticalOptions="Center" Margin="0,0,10,0"/>
                                <Entry Grid.Column="1"
                                       Placeholder="Enter location phone number"
                                       Text="{Binding LocationPhone}"
                                       Keyboard="Telephone"
                                       TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                       FontSize="14" HeightRequest="54"
                                       BackgroundColor="Transparent"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                    <!-- END business section -->

                    <!-- ══ CAPTCHA ════════════════════════════════════ -->
                    <Label Text="Human Verification"
                           FontSize="13" FontAttributes="Bold" TextColor="#1B2B3A"
                           Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="*,110" ColumnSpacing="12" Margin="0,0,0,8">

                        <!-- Question pill -->
                        <Border Grid.Column="0" StrokeThickness="0">
                            <Border.Background>
                                <SolidColorBrush Color="#F0F4F8"/>
                            </Border.Background>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding CaptchaQuestion}"
                                   FontSize="16" FontAttributes="Bold" TextColor="#1B2B3A"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   HeightRequest="54"/>
                        </Border>

                        <!-- Answer -->
                        <Border Grid.Column="1" StrokeThickness="1.5">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="Answer"
                                   Text="{Binding CaptchaAnswer}"
                                   Keyboard="Numeric"
                                   TextColor="#1B2B3A" PlaceholderColor="#B0BEC8"
                                   FontSize="14" HeightRequest="54"
                                   HorizontalTextAlignment="Center"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </Grid>

                    <!-- ══ MESSAGES ═══════════════════════════════════ -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            StrokeThickness="1" Margin="0,12,0,0">
                        <Border.Stroke>
                            <SolidColorBrush Color="#FCA5A5"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="#991B1B"
                               FontSize="13" Padding="14,12" LineBreakMode="WordWrap"/>
                    </Border>

                    <Border IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            StrokeThickness="1" Margin="0,12,0,0">
                        <Border.Stroke>
                            <SolidColorBrush Color="#6EE7B7"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding SuccessMessage}" TextColor="#065F46"
                               FontSize="13" Padding="14,12" LineBreakMode="WordWrap"/>
                    </Border>

                    <Border IsVisible="{Binding InfoMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            StrokeThickness="1" Margin="0,12,0,0">
                        <Border.Stroke>
                            <SolidColorBrush Color="#93C5FD"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding InfoMessage}" TextColor="#1E40AF"
                               FontSize="13" Padding="14,12" LineBreakMode="WordWrap"/>
                    </Border>

                    <!-- ══ CREATE ACCOUNT BUTTON ══════════════════════ -->
                    <Border HeightRequest="56" StrokeThickness="0" Margin="0,20,0,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F5A623" Offset="0"/>
                                <GradientStop Color="#E08A00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Button Text="{Binding RegisterButtonText}"
                                Command="{Binding RegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       HeightRequest="22" WidthRequest="22"
                                       Margin="0,0,0,8"/>

                    <!-- ── DIVIDER ─────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,8,0,16">
                        <BoxView Grid.Column="0" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Or sign up with"
                               FontSize="11" TextColor="#9BAABB" Margin="10,0"/>
                        <BoxView Grid.Column="2" Color="#E4EAF0" HeightRequest="1" VerticalOptions="Center"/>
                    </Grid>

                    <!-- ── SOCIAL: Google | Facebook | Apple ─────── -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,24">

                        <Border Grid.Column="0" StrokeThickness="1.5" HeightRequest="54">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RegisterWithGoogleCommand}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="G" FontSize="22" FontAttributes="Bold"
                                           TextColor="#EA4335" HorizontalOptions="Center"/>
                                    <Label Text="Google" FontSize="9" TextColor="#9BAABB" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" StrokeThickness="1.5" HeightRequest="54">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RegisterWithFacebookCommand}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="f" FontSize="24" FontAttributes="Bold"
                                           TextColor="#1877F2" HorizontalOptions="Center"/>
                                    <Label Text="Facebook" FontSize="9" TextColor="#9BAABB" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" StrokeThickness="1.5" HeightRequest="54">
                            <Border.Stroke>
                                <SolidColorBrush Color="#E4EAF0"/>
                            </Border.Stroke>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RegisterWithAppleCommand}"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                    <Label Text="🍎" FontSize="22" HorizontalOptions="Center"/>
                                    <Label Text="Apple" FontSize="9" TextColor="#9BAABB" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- ── SIGN IN LINK ────────────────────────────── -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="Already have an account?" FontSize="13" TextColor="#7A8E9C"/>
                        <Label Text="Sign In"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <controls:LoadingOverlay
            x:Name="PageLoadingOverlay"
            Grid.RowSpan="2"
            ZIndex="999"/>

    </Grid>
</ContentPage>
