<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.StorePage"
             xmlns:pagemodels="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:models="clr-namespace:CraftConnect_Mobile_App.Models"
             xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
             xmlns:controls="clr-namespace:CraftConnect_Mobile_App.Pages"
             x:DataType="pagemodels:StorePageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Shadow x:Key="CardShadow"
                    Brush="#2563EB"
                    Opacity="0.07"
                    Radius="12"
                    Offset="0,4"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ========================================
             HEADER WITH SEARCH
             ======================================== -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20,52,20,16">
            <Border.Shadow>
                <Shadow Brush="#2563EB"
                        Opacity="0.06"
                        Radius="8"
                        Offset="0,2"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- Top bar: title + cart + menu -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Column="0"
                           Text="CraftStore"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#0D0D0D"
                           VerticalOptions="Center"/>

                    <!-- Cart button — dark navy pill -->
                    <Grid Grid.Column="1" WidthRequest="48" HeightRequest="48">
                        <Border BackgroundColor="#1A2340"
                                StrokeThickness="0"
                                WidthRequest="42"
                                HeightRequest="42"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="13"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Offset="0,2" Radius="6" Opacity="0.18"/>
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewCartCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="🛒"
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <!-- Cart badge -->
                        <Border IsVisible="{Binding CartItemCount, Converter={StaticResource GreaterThanZeroConverter}}"
                                BackgroundColor="#2563EB"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Start"
                                HorizontalOptions="End"
                                Margin="0,-2,-2,0"
                                StrokeThickness="2"
                                Stroke="#FFFFFF">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding CartItemCount}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </Grid>

                    <!-- Menu button — blue accent pill -->
                    <Border Grid.Column="2"
                            BackgroundColor="#2563EB"
                            StrokeThickness="0"
                            WidthRequest="42"
                            HeightRequest="42">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#2563EB" Offset="0,3" Radius="8" Opacity="0.35"/>
                        </Border.Shadow>
                        <Label Text="☰"
                               FontSize="20"
                               TextColor="White"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Search bar -->
                <Border Grid.Row="1"
                        BackgroundColor="#F0F4FF"
                        StrokeThickness="0"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#2563EB" Offset="0,1" Radius="6" Opacity="0.06"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Opacity="0.5"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search products and services..."
                               FontSize="15"
                               TextColor="#0D0D0D"
                               PlaceholderColor="#BBBBBB"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ========================================
             CATEGORY FILTER CHIPS
             ======================================== -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="20,12,20,8">
            <HorizontalStackLayout Spacing="10" Padding="0,2,0,2">

                <!-- All — active (blue) -->
                <Border BackgroundColor="#2563EB"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#2563EB" Offset="0,2" Radius="6" Opacity="0.28"/>
                    </Border.Shadow>
                    <Label Text="All"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="White"/>
                </Border>

                <!-- Products -->
                <Border BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}"
                                              CommandParameter="Products"/>
                    </Border.GestureRecognizers>
                    <Label Text="📦 Products" FontSize="14" TextColor="#555555"/>
                </Border>

                <!-- Services -->
                <Border BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FilterCategoryCommand}"
                                              CommandParameter="Services"/>
                    </Border.GestureRecognizers>
                    <Label Text="🔧 Services" FontSize="14" TextColor="#555555"/>
                </Border>

                <!-- Construction -->
                <Border BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Label Text="🏗 Construction" FontSize="14" TextColor="#555555"/>
                </Border>

                <!-- Design -->
                <Border BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Label Text="🎨 Design" FontSize="14" TextColor="#555555"/>
                </Border>

                <!-- Tools -->
                <Border BackgroundColor="#FFFFFF"
                        StrokeThickness="0"
                        Padding="20,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,1" Radius="3" Opacity="0.06"/>
                    </Border.Shadow>
                    <Label Text="🛠 Tools" FontSize="14" TextColor="#555555"/>
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ========================================
             STORE ITEMS GRID
             ======================================== -->
        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="#2563EB">
            <ScrollView>
                <CollectionView ItemsSource="{Binding StoreItems}"
                                SelectionMode="None"
                                Margin="12,0,12,12">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="12"
                                         VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40"
                                             VerticalOptions="Center"
                                             Spacing="16">
                            <Label Text="🏪"
                                   FontSize="64"
                                   HorizontalOptions="Center"/>
                            <Label Text="No items available"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#0D0D0D"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Check back later for products and services"
                                   FontSize="14"
                                   TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:StoreItem">
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    Shadow="{StaticResource CardShadow}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pagemodels:StorePageModel}}, Path=ItemTappedCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="140,Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="8"
                                      Padding="0">

                                    <!-- Image area -->
                                    <Border Grid.Row="0"
                                            BackgroundColor="#EEF2FF"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18,18,0,0"/>
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="140"/>

                                            <!-- Type badge — dark navy -->
                                            <Border BackgroundColor="#1A2340"
                                                    StrokeThickness="0"
                                                    Padding="10,4"
                                                    VerticalOptions="Start"
                                                    HorizontalOptions="Start"
                                                    Margin="8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding TypeBadge}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="White"/>
                                            </Border>

                                            <!-- Wishlist heart -->
                                            <Border BackgroundColor="#FFFFFF"
                                                    StrokeThickness="0"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    VerticalOptions="Start"
                                                    HorizontalOptions="End"
                                                    Margin="8">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16"/>
                                                </Border.StrokeShape>
                                                <Label Text="♡"
                                                       FontSize="18"
                                                       TextColor="#2563EB"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Name -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0D0D0D"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"
                                           Margin="10,8,10,0"/>

                                    <!-- Seller -->
                                    <Label Grid.Row="2"
                                           Text="{Binding SellerName}"
                                           FontSize="12"
                                           TextColor="#6B7280"
                                           LineBreakMode="TailTruncation"
                                           Margin="10,0"/>

                                    <!-- Rating -->
                                    <HorizontalStackLayout Grid.Row="3"
                                                           Spacing="4"
                                                           Margin="10,0">
                                        <Label Text="⭐" FontSize="12" VerticalOptions="Center"/>
                                        <Label Text="{Binding Rating, StringFormat='{0:F1}'}"
                                               FontSize="12" TextColor="#0D0D0D" VerticalOptions="Center"/>
                                        <Label Text="{Binding ReviewCount, StringFormat='({0})'}"
                                               FontSize="11" TextColor="#9CA3AF" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- Price — blue -->
                                    <Label Grid.Row="4"
                                           Text="{Binding DisplayPrice}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB"
                                           Margin="10,4,10,0"/>

                                    <!-- Add to cart / Book button — blue -->
                                    <Border Grid.Row="5"
                                            BackgroundColor="#2563EB"
                                            StrokeThickness="0"
                                            Padding="0,10"
                                            Margin="8,8,8,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#2563EB" Offset="0,2" Radius="6" Opacity="0.28"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type pagemodels:StorePageModel}}, Path=AddToCartOrBookCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding ActionButtonText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </RefreshView>

        <!-- ========================================
             BOTTOM NAVIGATION
             ======================================== -->
        <controls:BottomNavBar x:Name="BottomNav"
                               Grid.Row="3"
                               ActiveTab="Store"/>
    </Grid>
</ContentPage>
