<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CraftConnect_Mobile_App.PageModels"
             xmlns:converters="clr-namespace:CraftConnect_Mobile_App.Converters"
             x:Class="CraftConnect_Mobile_App.Pages.PrivateChatPage"
             x:DataType="vm:PrivateChatPageModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#ECE5DD">

    <Shell.TitleView>
        <Grid/>
    </Shell.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Root Grid -->
    <Grid>

        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="0">

            <!-- ══ HEADER ══ -->
            <Grid Grid.Row="0"
                  BackgroundColor="#075E54"
                  ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                  RowSpacing="0">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="6,8,6,8"/>
                        <On Platform="iOS"     Value="6,48,6,8"/>
                    </OnPlatform>
                </Grid.Padding>

                <!-- Back arrow -->
                <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5c4;" FontFamily="MaterialIcons" FontSize="24"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>

                <!-- Avatar -->
                <Grid Grid.Column="1" WidthRequest="40" HeightRequest="40"
                      VerticalOptions="Center" Margin="2,0,10,0">
                    <Border WidthRequest="40" HeightRequest="40"
                            BackgroundColor="#128C7E" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding OtherUserName, Converter={StaticResource FirstLetterConverter}}"
                               FontSize="17" FontAttributes="Bold" TextColor="White"
                               VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                    <!-- Online dot -->
                    <Border WidthRequest="12" HeightRequest="12"
                            BackgroundColor="#25D366" StrokeThickness="1.5"
                            HorizontalOptions="End" VerticalOptions="End">
                        <Border.Stroke>
                            <SolidColorBrush Color="#075E54"/>
                        </Border.Stroke>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                    </Border>
                </Grid>

                <!-- Name + status -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                    <Label Text="{Binding OtherUserName}" FontSize="17" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="TailTruncation"/>
                    <Label Text="online" FontSize="12" TextColor="#B2DFDB"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Video call icon -->
                <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe04b;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>

                <!-- More options -->
                <Border Grid.Column="4" BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                    <Label Text="&#xe5d4;" FontFamily="MaterialIcons" FontSize="22"
                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                </Border>
            </Grid>

            <!-- ══ MESSAGES AREA ══ -->
            <Grid Grid.Row="1" BackgroundColor="#ECE5DD">

                <CollectionView x:Name="MessagesCollectionView"
                                ItemsSource="{Binding Messages}"
                                SelectionMode="None"
                                BackgroundColor="Transparent">

                    <CollectionView.Header>
                        <Grid Padding="0,10,0,6">
                            <Border BackgroundColor="White" StrokeThickness="0"
                                    Padding="14,4" HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="TODAY" FontSize="12" TextColor="#667781"
                                       FontAttributes="Bold" CharacterSpacing="1.5"/>
                            </Border>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" VerticalOptions="Center"
                                             HorizontalOptions="Center" Spacing="12">
                            <Border WidthRequest="72" HeightRequest="72"
                                    BackgroundColor="White" StrokeThickness="0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36"/>
                                </Border.StrokeShape>
                                <Label Text="&#xe0c6;" FontFamily="MaterialIcons" FontSize="36"
                                       TextColor="#B0BEC5" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="No messages yet" FontSize="16" TextColor="#546E7A"
                                   HorizontalTextAlignment="Center" FontAttributes="Bold"/>
                            <Label Text="Send a message to start the conversation"
                                   FontSize="13" TextColor="#90A4AE" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrivateMessageItemViewModel">
                            <Grid Padding="6,2,6,2">

                                <!-- ── INCOMING (LEFT) ── -->
                                <Border
                                    IsVisible="{Binding IsFromCurrentUser, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start"
                                    MaximumWidthRequest="290">
                                    <Border.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnMessagePanUpdated"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="0">
                                        <Border BackgroundColor="White" StrokeThickness="0"
                                                Padding="10,6,10,6" Margin="0,2,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,8,8,8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">

                                                <!-- Reply preview -->
                                                <Border IsVisible="{Binding HasReply}"
                                                        BackgroundColor="#E8F5E9"
                                                        StrokeThickness="0"
                                                        Padding="8,4" Margin="0,0,0,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4"/>
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnReplyPreviewTapped"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding ReplyToSenderName}"
                                                               FontSize="12" FontAttributes="Bold"
                                                               TextColor="#075E54"/>
                                                        <Label Text="{Binding ReplyToText}"
                                                               FontSize="12" TextColor="#667781"
                                                               LineBreakMode="TailTruncation" MaxLines="1"/>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <!-- Pinned indicator -->
                                                <HorizontalStackLayout IsVisible="{Binding IsPinned}"
                                                                        Spacing="4" Margin="0,0,0,2">
                                                    <Label Text="&#xe54d;" FontFamily="MaterialIcons"
                                                           FontSize="11" TextColor="#075E54"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="Pinned" FontSize="10"
                                                           TextColor="#075E54" FontAttributes="Italic"/>
                                                </HorizontalStackLayout>

                                                <!-- Text -->
                                                <Label Text="{Binding Message}"
                                                       FontSize="15" TextColor="#111B21"
                                                       LineBreakMode="WordWrap"
                                                       IsVisible="{Binding HasMessageText}"/>

                                                <!-- Timestamp -->
                                                <Label Text="{Binding DisplayTime}"
                                                       FontSize="11" TextColor="#667781"
                                                       HorizontalOptions="End" Margin="0,2,0,0"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- ── OUTGOING (RIGHT) ── -->
                                <Border
                                    IsVisible="{Binding IsFromCurrentUser}"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    MaximumWidthRequest="290">
                                    <Border.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnMessagePanUpdated"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="0">
                                        <Border BackgroundColor="#DCF8C6" StrokeThickness="0"
                                                Padding="10,6,10,6" Margin="0,2,0,2">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8,0,8,8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">

                                                <!-- Reply preview (outgoing) -->
                                                <Border IsVisible="{Binding HasReply}"
                                                        BackgroundColor="#B9F5CE"
                                                        StrokeThickness="0"
                                                        Padding="8,4" Margin="0,0,0,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4"/>
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Tapped="OnReplyPreviewTapped"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding ReplyToSenderName}"
                                                               FontSize="12" FontAttributes="Bold"
                                                               TextColor="#075E54"/>
                                                        <Label Text="{Binding ReplyToText}"
                                                               FontSize="12" TextColor="#667781"
                                                               LineBreakMode="TailTruncation" MaxLines="1"/>
                                                    </VerticalStackLayout>
                                                </Border>

                                                <!-- Pinned indicator -->
                                                <HorizontalStackLayout IsVisible="{Binding IsPinned}"
                                                                        Spacing="4" Margin="0,0,0,2">
                                                    <Label Text="&#xe54d;" FontFamily="MaterialIcons"
                                                           FontSize="11" TextColor="#075E54"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="Pinned" FontSize="10"
                                                           TextColor="#075E54" FontAttributes="Italic"/>
                                                </HorizontalStackLayout>

                                                <!-- Text -->
                                                <Label Text="{Binding Message}"
                                                       FontSize="15" TextColor="#111B21"
                                                       LineBreakMode="WordWrap"
                                                       IsVisible="{Binding HasMessageText}"/>

                                                <!-- Time + ticks -->
                                                <HorizontalStackLayout HorizontalOptions="End"
                                                                        Spacing="3" Margin="0,2,0,0">
                                                    <Label Text="{Binding DisplayTime}"
                                                           FontSize="11" TextColor="#667781"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding StatusIcon}"
                                                           FontSize="13" TextColor="#667781"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding IsFromCurrentUser}"/>
                                                </HorizontalStackLayout>

                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Loading spinner -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#075E54" WidthRequest="28" HeightRequest="28"
                                   VerticalOptions="Start" HorizontalOptions="Center"
                                   Margin="0,12,0,0" ZIndex="99"/>
            </Grid>

            <!-- ══ REPLY BAR ══ -->
            <Grid Grid.Row="2"
                  IsVisible="{Binding IsReplying}"
                  BackgroundColor="#F0F2F5"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="12,6,8,6"
                  ColumnSpacing="8">
                <BoxView Grid.Column="0" WidthRequest="3" BackgroundColor="#075E54"
                         VerticalOptions="Fill" CornerRadius="2"/>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding ReplyingToSender}" FontSize="12"
                           FontAttributes="Bold" TextColor="#075E54"/>
                    <Label Text="{Binding ReplyingToMessage}" FontSize="12"
                           TextColor="#667781" LineBreakMode="TailTruncation" MaxLines="1"/>
                </VerticalStackLayout>
                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                        WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelReplyTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe5cd;" FontFamily="MaterialIcons" FontSize="20"
                           TextColor="#667781" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- ══ INPUT BAR ══ -->
            <Grid x:Name="MessageInputArea"
                  Grid.Row="3"
                  BackgroundColor="#F0F2F5"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="Android" Value="8,6,8,10"/>
                        <On Platform="Default" Value="8,6,8,6"/>
                    </OnPlatform>
                </Grid.Padding>

                <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumHeightRequest="46" MaximumHeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0" Padding="6,0">
                        <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                            <Label Text="&#xe24e;" FontFamily="MaterialIcons" FontSize="24"
                                   TextColor="#8696A0" VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>
                        <Editor Grid.Column="1"
                                x:Name="MessageEditor"
                                Text="{Binding MessageText}"
                                Placeholder="Message"
                                AutoSize="TextChanges"
                                FontSize="16"
                                TextColor="#111B21"
                                PlaceholderColor="#8696A0"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                MinimumHeightRequest="28"
                                MaximumHeightRequest="100"/>
                        <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="36" HeightRequest="36" VerticalOptions="Center"
                                Margin="0,0,6,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAttachmentButtonTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="&#xe226;" FontFamily="MaterialIcons" FontSize="24"
                                   TextColor="#8696A0" Rotation="-45"
                                   VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Send button -->
                <Border Grid.Column="1"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="#075E54"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xe163;" FontFamily="MaterialIcons" FontSize="24"
                           TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ CONTEXT MENU OVERLAY ══ -->
        <Grid x:Name="ContextMenuOverlay"
              IsVisible="{Binding IsContextMenuVisible}"
              BackgroundColor="#80000000"
              ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnContextMenuDismissed"/>
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="240">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <!-- Reply -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextReplyTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe8af;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Reply" FontSize="15"
                               TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Forward -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextForwardTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe154;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Forward" FontSize="15"
                               TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Copy -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextCopyTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe14d;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Copy" FontSize="15"
                               TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Pin -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextPinTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe54d;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding SelectedMessage.PinLabel}"
                               FontSize="15" TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Star -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextStarTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="{Binding SelectedMessage.StarIcon}"
                               FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding SelectedMessage.StarLabel}"
                               FontSize="15" TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Select -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextSelectTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe9f5;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#075E54" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Select" FontSize="15"
                               TextColor="#111B21" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="0.5" BackgroundColor="#E0E0E0"/>

                    <!-- Delete -->
                    <Grid Padding="16,14" ColumnDefinitions="Auto,*" ColumnSpacing="14"
                          BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnContextDeleteTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="&#xe872;" FontFamily="MaterialIcons"
                               FontSize="22" TextColor="#D32F2F" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Delete" FontSize="15"
                               TextColor="#D32F2F" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ══ SELECTION MODE TOOLBAR ══
             Shown when one or more messages are selected. -->
        <Grid x:Name="SelectionToolbar"
              IsVisible="{Binding IsSelectionMode}"
              BackgroundColor="#075E54"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              ColumnSpacing="4"
              ZIndex="101"
              VerticalOptions="Start">
            <Grid.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="Android" Value="8,8,8,8"/>
                    <On Platform="iOS"     Value="8,48,8,8"/>
                </OnPlatform>
            </Grid.Padding>

            <!-- Close selection -->
            <Border Grid.Column="0" BackgroundColor="Transparent" StrokeThickness="0"
                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelSelectionTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xe5cd;" FontFamily="MaterialIcons" FontSize="24"
                       TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>

            <!-- Selection count -->
            <Label Grid.Column="1" Text="{Binding SelectionCountText}"
                   FontSize="17" FontAttributes="Bold" TextColor="White"
                   VerticalOptions="Center" Margin="8,0"/>

            <!-- Forward selected -->
            <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForwardSelectedTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xe154;" FontFamily="MaterialIcons" FontSize="22"
                       TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>

            <!-- Star selected -->
            <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0"
                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStarSelectedTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xe838;" FontFamily="MaterialIcons" FontSize="22"
                       TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>

            <!-- Delete selected -->
            <Border Grid.Column="4" BackgroundColor="Transparent" StrokeThickness="0"
                    WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteSelectedTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xe872;" FontFamily="MaterialIcons" FontSize="22"
                       TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
