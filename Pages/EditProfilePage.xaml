<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.EditProfilePage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top bar ── -->
        <Grid Grid.Row="0" BackgroundColor="#1B2B3A" Padding="16,52,16,16"
              ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0" Source="chevron_left.png"
                         WidthRequest="24" HeightRequest="24"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"/>
            <Label x:Name="PageTitleLabel" Grid.Column="1" Text="Edit Profile"
                   TextColor="White" FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <ActivityIndicator x:Name="SaveIndicator" Grid.Column="2"
                               IsRunning="False" IsVisible="False"
                               Color="White" WidthRequest="22" HeightRequest="22"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                <!-- Loading indicator -->
                <ActivityIndicator x:Name="PageLoadingIndicator"
                                   IsRunning="True" IsVisible="True"
                                   Color="#2E6FD8" HorizontalOptions="Center"
                                   Margin="0,40,0,0"/>

                <!-- ── Photo section (shared by all roles) ── -->
                <Frame x:Name="PhotoSection" BackgroundColor="White" CornerRadius="14"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PROFILE PHOTO" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <Grid HorizontalOptions="Center" WidthRequest="80" HeightRequest="80">
                            <Frame x:Name="EditInitialsFrame"
                                   WidthRequest="80" HeightRequest="80" CornerRadius="40"
                                   Padding="0" HasShadow="False" IsClippedToBounds="True">
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4DA6E8" Offset="0"/>
                                        <GradientStop Color="#2E6FD8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Frame.Background>
                                <Label x:Name="EditInitialsLabel" Text="?"
                                       TextColor="White" FontSize="28" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Frame x:Name="EditPhotoFrame"
                                   WidthRequest="80" HeightRequest="80" CornerRadius="40"
                                   Padding="0" HasShadow="False" IsClippedToBounds="True"
                                   IsVisible="False">
                                <Image x:Name="EditPhoto" Aspect="AspectFill"
                                       WidthRequest="80" HeightRequest="80"/>
                            </Frame>
                        </Grid>

                        <Button Text="Change Photo"
                                BackgroundColor="#EBF3FB"
                                TextColor="#2E6FD8"
                                CornerRadius="10"
                                FontSize="13"
                                HeightRequest="40"
                                Clicked="OnChangePhotoClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- CUSTOMER / ADMIN  — personal info fields           -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="PersonalInfoSection" BackgroundColor="White" CornerRadius="14"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PERSONAL INFO" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <!-- Full name -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Full Name" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="FullNameEntry" Placeholder="Your full name"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Bio -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Bio" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="BioEditor" Placeholder="Tell people about yourself"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="90" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Address -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Address" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="AddressEntry" Placeholder="Street address"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- City / State row -->
                        <Grid ColumnDefinitions="*,12,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="City" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="CityEntry" Placeholder="City"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="State" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="StateEntry" Placeholder="State"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Country / Postal row -->
                        <Grid ColumnDefinitions="*,12,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Country" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="CountryEntry" Placeholder="Country"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Postal Code" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="PostalCodeEntry" Placeholder="Postal code"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           Keyboard="Numeric"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════════ -->
                <!-- ARTISAN — business info fields                     -->
                <!-- ══════════════════════════════════════════════════ -->
                <Frame x:Name="ArtisanInfoSection" BackgroundColor="White" CornerRadius="14"
                       Padding="20" HasShadow="False" BorderColor="#E8EDF2"
                       IsVisible="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="BUSINESS INFO" TextColor="#8A9BAD" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.2"/>

                        <!-- Business name -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Business Name" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="BusinessNameEntry" Placeholder="Your business name"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Specialization -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Specialization" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="SpecializationEntry" Placeholder="e.g. Plumber, Electrician"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Artisan Speciality -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Artisan Speciality" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="ArtisanSpecialityEntry" Placeholder="Your niche or speciality"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Hourly rate / Years row -->
                        <Grid ColumnDefinitions="*,12,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Hourly Rate (GH₵)" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="HourlyRateEntry" Placeholder="0.00"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           Keyboard="Numeric"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="Years Experience" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="YearsExperienceEntry" Placeholder="0"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           Keyboard="Numeric"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Experience level picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Experience Level" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Picker x:Name="ExperienceLevelPicker"
                                        FontSize="15" TextColor="#1B2B3A"
                                        Title="Select level"
                                        TitleColor="#A0B4C8"
                                        VerticalOptions="Center">
                                    <Picker.Items>
                                        <x:String>BEGINNER</x:String>
                                        <x:String>INTERMEDIATE</x:String>
                                        <x:String>EXPERIENCED</x:String>
                                        <x:String>EXPERT</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Availability picker -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Availability Status" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Picker x:Name="AvailabilityPicker"
                                        FontSize="15" TextColor="#1B2B3A"
                                        Title="Select status"
                                        TitleColor="#A0B4C8"
                                        VerticalOptions="Center">
                                    <Picker.Items>
                                        <x:String>AVAILABLE</x:String>
                                        <x:String>BUSY</x:String>
                                        <x:String>UNAVAILABLE</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Service radius -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Service Radius (km)" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="ServiceRadiusEntry" Placeholder="e.g. 25"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       Keyboard="Numeric"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- About -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="About" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="AboutEditor"
                                        Placeholder="Describe your work and experience"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="90" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Professional Bio -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Professional Bio" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="ProfessionalBioEditor"
                                        Placeholder="A longer professional bio"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="90" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Services Offered -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Services Offered" FontSize="13" TextColor="#5A7184"/>
                            <Label Text="Separate multiple services with a comma"
                                   FontSize="11" TextColor="#A0B4C8"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,8"
                                   HasShadow="False" BorderColor="#E8EDF2">
                                <Editor x:Name="ServicesOfferedEditor"
                                        Placeholder="e.g. Pipe fitting, Drain repair"
                                        FontSize="15" TextColor="#1B2B3A"
                                        PlaceholderColor="#A0B4C8"
                                        HeightRequest="70" AutoSize="Disabled"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Business address -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Business Address" FontSize="13" TextColor="#5A7184"/>
                            <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                   HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                <Entry x:Name="BusinessAddressEntry"
                                       Placeholder="Where customers can reach you"
                                       FontSize="15" TextColor="#1B2B3A"
                                       PlaceholderColor="#A0B4C8"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- Save button -->
                <Button x:Name="SaveButton"
                        Text="Save Changes"
                        BackgroundColor="#2E6FD8"
                        TextColor="White"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        IsVisible="False"
                        Clicked="OnSaveClicked"
                        Margin="0,4,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
