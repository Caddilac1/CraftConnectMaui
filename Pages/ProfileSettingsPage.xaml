<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.ProfileSettingsPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Top bar ── -->
        <Grid Grid.Row="0" BackgroundColor="#1B2B3A" Padding="16,52,16,16"
              ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0" Source="chevron_left.png"
                         WidthRequest="24" HeightRequest="24"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="Profile Settings"
                   TextColor="White" FontSize="18" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
            <ActivityIndicator x:Name="SaveIndicator" Grid.Column="2"
                               IsRunning="False" IsVisible="False"
                               Color="White" WidthRequest="22" HeightRequest="22"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                <!-- ── Change Password ── -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="SECURITY" TextColor="#8A9BAD" FontSize="12"
                           FontAttributes="Bold" Margin="4,0,0,8" CharacterSpacing="1.2"/>
                    <Frame BackgroundColor="White" CornerRadius="14" Padding="20"
                           HasShadow="False" BorderColor="#E8EDF2">
                        <VerticalStackLayout Spacing="14">

                            <!-- Current password -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Current Password" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="CurrentPasswordEntry"
                                           Placeholder="Enter current password"
                                           IsPassword="True"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- New password -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="New Password" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="NewPasswordEntry"
                                           Placeholder="At least 8 characters"
                                           IsPassword="True"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           TextChanged="OnNewPasswordChanged"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Confirm password -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Confirm New Password" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Entry x:Name="ConfirmPasswordEntry"
                                           Placeholder="Re-enter new password"
                                           IsPassword="True"
                                           FontSize="15" TextColor="#1B2B3A"
                                           PlaceholderColor="#A0B4C8"
                                           TextChanged="OnConfirmPasswordChanged"
                                           VerticalOptions="Center"/>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Password match indicator -->
                            <Label x:Name="PasswordMatchLabel" Text=""
                                   FontSize="12" IsVisible="False"/>

                            <Button Text="Update Password"
                                    BackgroundColor="#2E6FD8"
                                    TextColor="White"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    Clicked="OnUpdatePasswordClicked"/>

                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- ── Preferences ── -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="PREFERENCES" TextColor="#8A9BAD" FontSize="12"
                           FontAttributes="Bold" Margin="4,0,0,8" CharacterSpacing="1.2"/>
                    <Frame BackgroundColor="White" CornerRadius="14" Padding="20"
                           HasShadow="False" BorderColor="#E8EDF2">
                        <VerticalStackLayout Spacing="14">

                            <!-- Language -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Preferred Language" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Picker x:Name="LanguagePicker"
                                            FontSize="15" TextColor="#1B2B3A"
                                            Title="Select language"
                                            TitleColor="#A0B4C8"
                                            VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>English</x:String>
                                            <x:String>French</x:String>
                                            <x:String>Twi</x:String>
                                            <x:String>Hausa</x:String>
                                            <x:String>Ewe</x:String>
                                            <x:String>Ga</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Frame>
                            </VerticalStackLayout>

                            <!-- Timezone -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Timezone" FontSize="13" TextColor="#5A7184"/>
                                <Frame BackgroundColor="#F8FAFC" CornerRadius="10" Padding="12,0"
                                       HasShadow="False" BorderColor="#E8EDF2" HeightRequest="48">
                                    <Picker x:Name="TimezonePicker"
                                            FontSize="15" TextColor="#1B2B3A"
                                            Title="Select timezone"
                                            TitleColor="#A0B4C8"
                                            VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>Africa/Accra</x:String>
                                            <x:String>Africa/Lagos</x:String>
                                            <x:String>Africa/Nairobi</x:String>
                                            <x:String>Africa/Johannesburg</x:String>
                                            <x:String>Europe/London</x:String>
                                            <x:String>America/New_York</x:String>
                                            <x:String>America/Los_Angeles</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Frame>
                            </VerticalStackLayout>

                            <Button Text="Save Preferences"
                                    BackgroundColor="#2E6FD8"
                                    TextColor="White"
                                    CornerRadius="10"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    Clicked="OnSavePreferencesClicked"/>

                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
