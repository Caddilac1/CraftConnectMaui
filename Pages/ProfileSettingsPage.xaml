<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CraftConnect_Mobile_App.Pages.ProfileSettingsPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#1B2B3A"
              Padding="16,52,16,20"
              ColumnDefinitions="Auto,*,Auto">
            <ImageButton Grid.Column="0"
                         Source="chevron_left.svg"
                         WidthRequest="24"
                         HeightRequest="24"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent"
                         Clicked="OnBackClicked"/>
            <Label Grid.Column="1"
                   Text="Profile Settings"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <BoxView Grid.Column="2" WidthRequest="24"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16,20,16,30">

                <!-- Avatar Section -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Frame WidthRequest="90"
                           HeightRequest="90"
                           CornerRadius="22"
                           Padding="0"
                           HasShadow="False"
                           HorizontalOptions="Center"
                           IsClippedToBounds="True">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4DA6E8" Offset="0"/>
                                <GradientStop Color="#2E6FD8" Offset="1"/>
                            </LinearGradientBrush>
                        </Frame.Background>
                        <Label x:Name="AvatarInitialsLabel"
                               Text="JD"
                               TextColor="White"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                    <Label x:Name="FullNameHeaderLabel"
                           Text="John Doe"
                           TextColor="#1B2B3A"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="RoleLabel"
                           Text="Artisan"
                           TextColor="#4DA6E8"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- PERSONAL INFO -->
                <VerticalStackLayout Spacing="0">
                    <Label Text="PERSONAL INFO"
                           TextColor="#8A9BAD"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="4,0,0,8"
                           CharacterSpacing="1.2"/>

                    <Frame BackgroundColor="White"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False"
                           BorderColor="#E8EDF2">
                        <VerticalStackLayout Spacing="0">

                            <!-- Full Name -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="Full Name"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="FullNameLabel"
                                       Text="John Doe"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                            <!-- Email -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="EMAIL ADDRESS"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="EmailLabel"
                                       Text="john.doe@craftconnect.com"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                            <!-- Phone -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="PHONE NUMBER"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="PhoneLabel"
                                       Text="+233 24 123 4567"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                            <!-- Role -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="ACCOUNT TYPE"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="AccountTypeLabel"
                                       Text="Artisan"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- ARTISAN INFO (shown only for artisans) -->
                <VerticalStackLayout x:Name="ArtisanInfoSection" Spacing="0" IsVisible="False">
                    <Label Text="BUSINESS INFO"
                           TextColor="#8A9BAD"
                           FontSize="12"
                           FontAttributes="Bold"
                           Margin="4,0,0,8"
                           CharacterSpacing="1.2"/>

                    <Frame BackgroundColor="White"
                           CornerRadius="14"
                           Padding="0"
                           HasShadow="False"
                           BorderColor="#E8EDF2">
                        <VerticalStackLayout Spacing="0">

                            <!-- Business Name -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="BUSINESS NAME"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="BusinessNameLabel"
                                       Text="—"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                            <!-- Specializations -->
                            <VerticalStackLayout Padding="16,14" Spacing="4">
                                <Label Text="SPECIALIZATIONS"
                                       TextColor="#8A9BAD"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"/>
                                <Label x:Name="SpecializationsLabel"
                                       Text="—"
                                       TextColor="#1B2B3A"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F0F4F8" Margin="16,0"/>

                            <!-- Availability -->
                            <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="AVAILABILITY"
                                           TextColor="#8A9BAD"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.8"/>
                                    <Label x:Name="AvailabilityLabel"
                                           Text="Available"
                                           TextColor="#10B981"
                                           FontSize="15"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Frame Grid.Column="1"
                                       x:Name="AvailabilityBadge"
                                       BackgroundColor="#D1FAE5"
                                       CornerRadius="10"
                                       Padding="10,4"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <Label Text="ACTIVE"
                                           TextColor="#10B981"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.5"/>
                                </Frame>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Edit Profile Button -->
                <Frame BackgroundColor="#1B2B3A"
                       CornerRadius="14"
                       Padding="0"
                       HasShadow="False"
                       BorderColor="Transparent"
                       Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*"
                          Padding="20,16"
                          ColumnSpacing="12">
                        <Image Grid.Column="0"
                               Source="edit.svg"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Edit Profile"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEditProfileClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
