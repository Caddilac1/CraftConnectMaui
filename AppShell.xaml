<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CraftConnect_Mobile_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CraftConnect_Mobile_App.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="Transparent">

    <!-- Auth -->
    <ShellContent Route="LoginPage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  Shell.BackgroundColor="Transparent"
                  ContentTemplate="{DataTemplate pages:LoginPage}"/>

    <!-- Main app tabs — these are top-level pages reachable via //RouteName -->
    <ShellContent Route="GroupChatListPage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  Shell.BackgroundColor="Transparent"
                  ContentTemplate="{DataTemplate pages:GroupChatListPage}"/>

    <ShellContent Route="UpdatesFeedPage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  Shell.BackgroundColor="Transparent"
                  ContentTemplate="{DataTemplate pages:UpdatesFeedPage}"/>

    <ShellContent Route="StorePage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  Shell.BackgroundColor="Transparent"
                  ContentTemplate="{DataTemplate pages:StorePage}"/>

    <ShellContent Route="SettingsPage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"
                  Shell.BackgroundColor="Transparent"
                  ContentTemplate="{DataTemplate pages:SettingsPage}"/>

    <!--
        CartPage and CheckoutPage are NOT ShellContent here.
        They are registered via Routing.RegisterRoute in AppShell.xaml.cs
        so that GoToAsync("cart") pushes them onto the navigation stack
        and GoToAsync("..") pops back correctly.
    -->
</Shell>
